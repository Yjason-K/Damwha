[
 {
  "speaker": "박준영",
  "start": 0.0,
  "end": 3.2758,
  "overlap": false,
  "text": "시작하겠습니다. 오늘은 금요일 알림 건 회고고요.",
  "line": 15
 },
 {
  "speaker": "박준영",
  "start": 3.4472,
  "end": 9.1582,
  "overlap": false,
  "text": "시작하기 전에 하나만 말씀드리면, 오늘 자리는 누구 잘못인지 찾는 자리가 아닙니다.",
  "line": 16
 },
 {
  "speaker": "박준영",
  "start": 9.3674,
  "end": 13.7951,
  "overlap": false,
  "text": "뭐가 왜 일어났고 다음에 어떻게 막을지만 보겠습니다.",
  "line": 17
 },
 {
  "speaker": "김서연",
  "start": 13.0945,
  "end": 13.358,
  "overlap": true,
  "text": "네.",
  "line": 18
 },
 {
  "speaker": "이도현",
  "start": 12.7669,
  "end": 13.0812,
  "overlap": true,
  "text": "네.",
  "line": 19
 },
 {
  "speaker": "박준영",
  "start": 14.2516,
  "end": 16.8567,
  "overlap": false,
  "text": "서연님, 상황부터 정리해주시겠어요.",
  "line": 20
 },
 {
  "speaker": "김서연",
  "start": 17.5166,
  "end": 17.7801,
  "overlap": false,
  "text": "네.",
  "line": 21
 },
 {
  "speaker": "김서연",
  "start": 20.0499,
  "end": 25.4621,
  "overlap": false,
  "text": "금요일 오후 두시 십사분에 알림이 중복으로 나가기 시작했습니다.",
  "line": 23
 },
 {
  "speaker": "김서연",
  "start": 25.652,
  "end": 29.4255,
  "overlap": false,
  "text": "처음 신고는 두시 사십분쯤 CS로 들어왔고요.",
  "line": 24
 },
 {
  "speaker": "김서연",
  "start": 29.7591,
  "end": 32.655,
  "overlap": false,
  "text": "알림 껐습니다. 세시 이분에요.",
  "line": 25
 },
 {
  "speaker": "박준영",
  "start": 33.1232,
  "end": 35.1392,
  "overlap": false,
  "text": "사십팔 분 동안 나간 거네요.",
  "line": 26
 },
 {
  "speaker": "김서연",
  "start": 35.7739,
  "end": 36.0375,
  "overlap": false,
  "text": "네.",
  "line": 27
 },
 {
  "speaker": "김서연",
  "start": 36.3167,
  "end": 43.0367,
  "overlap": false,
  "text": "영향받은 사용자는 이백십팔 명이고요, 총 발송 건수는 삼천사백십이 건입니다.",
  "line": 28
 },
 {
  "speaker": "이도현",
  "start": 43.6951,
  "end": 44.7759,
  "overlap": false,
  "text": "삼천사백이요?",
  "line": 29
 },
 {
  "speaker": "김서연",
  "start": 45.528,
  "end": 45.7915,
  "overlap": false,
  "text": "네.",
  "line": 30
 },
 {
  "speaker": "김서연",
  "start": 46.126,
  "end": 50.6549,
  "overlap": false,
  "text": "한 사람 기준으로 제일 많이 받으신 분이 사십 번입니다.",
  "line": 31
 },
 {
  "speaker": "최민지",
  "start": 54.6287,
  "end": 55.6669,
  "overlap": false,
  "text": "사십 번이요.",
  "line": 33
 },
 {
  "speaker": "김서연",
  "start": 56.2374,
  "end": 56.501,
  "overlap": false,
  "text": "네.",
  "line": 34
 },
 {
  "speaker": "이도현",
  "start": 57.2901,
  "end": 58.5058,
  "overlap": false,
  "text": "아 그건 좀...",
  "line": 35
 },
 {
  "speaker": "박준영",
  "start": 59.3235,
  "end": 60.3411,
  "overlap": false,
  "text": "어떤 분이세요.",
  "line": 36
 },
 {
  "speaker": "김서연",
  "start": 60.9167,
  "end": 65.3163,
  "overlap": false,
  "text": "반복 일정을 여섯 개 걸어두신 분이에요. 팀이 여러 개라서요.",
  "line": 37
 },
 {
  "speaker": "최민지",
  "start": 65.7172,
  "end": 67.6712,
  "overlap": false,
  "text": "그분 인터뷰하셨던 분 아니에요?",
  "line": 38
 },
 {
  "speaker": "김서연",
  "start": 68.6553,
  "end": 69.5414,
  "overlap": false,
  "text": "맞습니다.",
  "line": 39
 },
 {
  "speaker": "박준영",
  "start": 73.1204,
  "end": 74.0631,
  "overlap": false,
  "text": "음.",
  "line": 41
 },
 {
  "speaker": "최민지",
  "start": 74.6515,
  "end": 75.2894,
  "overlap": false,
  "text": "하필이요.",
  "line": 42
 },
 {
  "speaker": "박준영",
  "start": 76.2244,
  "end": 78.7195,
  "overlap": false,
  "text": "네. 그건 제가 따로 연락드리겠습니다.",
  "line": 43
 },
 {
  "speaker": "박준영",
  "start": 81.0158,
  "end": 82.6058,
  "overlap": false,
  "text": "원인이 뭔가요.",
  "line": 45
 },
 {
  "speaker": "김서연",
  "start": 83.2886,
  "end": 86.1511,
  "overlap": false,
  "text": "알림 스케줄러가 중복으로 돌았습니다.",
  "line": 46
 },
 {
  "speaker": "김서연",
  "start": 86.4944,
  "end": 95.9418,
  "overlap": false,
  "text": "저희가 매일 새벽에 다음 날 알림을 등록하는데요, 반복 일정은 회차별로 등록해야 되니까 전개를 해서 넣습니다.",
  "line": 47
 },
 {
  "speaker": "김서연",
  "start": 96.0994,
  "end": 99.2451,
  "overlap": false,
  "text": "그 배치가 금요일에 두 번 돌았어요.",
  "line": 48
 },
 {
  "speaker": "박준영",
  "start": 100.0693,
  "end": 101.8683,
  "overlap": false,
  "text": "왜 두 번 돌았죠.",
  "line": 49
 },
 {
  "speaker": "김서연",
  "start": 102.4928,
  "end": 109.0527,
  "overlap": false,
  "text": "목요일 밤에 배포가 있었고요, 배포 중에 인스턴스가 두 개 떠 있는 구간이 있었습니다.",
  "line": 50
 },
 {
  "speaker": "김서연",
  "start": 109.2254,
  "end": 113.2448,
  "overlap": false,
  "text": "롤링 배포라 새 거랑 옛날 게 잠깐 같이 살아 있거든요.",
  "line": 51
 },
 {
  "speaker": "김서연",
  "start": 113.5599,
  "end": 115.915,
  "overlap": false,
  "text": "둘 다 스케줄러를 돌렸습니다.",
  "line": 52
 },
 {
  "speaker": "이도현",
  "start": 115.1493,
  "end": 115.5827,
  "overlap": true,
  "text": "아.",
  "line": 53
 },
 {
  "speaker": "김서연",
  "start": 116.4393,
  "end": 122.1827,
  "overlap": false,
  "text": "그리고 그게 두 번이 아니라 실제로는 회차마다 여러 번이었어요.",
  "line": 54
 },
 {
  "speaker": "김서연",
  "start": 122.4902,
  "end": 129.9006,
  "overlap": false,
  "text": "재시도 로직이 있어서요. 실패하면 다시 넣는데, 실패한 게 아니라 느렸던 거였습니다.",
  "line": 55
 },
 {
  "speaker": "박준영",
  "start": 130.4795,
  "end": 133.3656,
  "overlap": false,
  "text": "그러면 성공한 것도 다시 넣은 거네요.",
  "line": 56
 },
 {
  "speaker": "김서연",
  "start": 132.6947,
  "end": 132.9583,
  "overlap": true,
  "text": "네.",
  "line": 57
 },
 {
  "speaker": "박준영",
  "start": 137.1989,
  "end": 138.917,
  "overlap": false,
  "text": "중복 확인은 안 하나요.",
  "line": 59
 },
 {
  "speaker": "김서연",
  "start": 139.4482,
  "end": 142.5617,
  "overlap": false,
  "text": "합니다. 넣기 전에 이미 있는지 봅니다.",
  "line": 60
 },
 {
  "speaker": "김서연",
  "start": 142.9192,
  "end": 148.067,
  "overlap": false,
  "text": "그런데 그게 확인하고 넣는 사이에 다른 쪽이 먼저 넣으면 지나갑니다.",
  "line": 61
 },
 {
  "speaker": "이도현",
  "start": 148.8616,
  "end": 149.7005,
  "overlap": false,
  "text": "아 그거...",
  "line": 62
 },
 {
  "speaker": "김서연",
  "start": 150.5102,
  "end": 150.7737,
  "overlap": false,
  "text": "네.",
  "line": 63
 },
 {
  "speaker": "김서연",
  "start": 154.1287,
  "end": 157.3368,
  "overlap": false,
  "text": "이거 이 주 전에 이 자리에서 얘기했던 겁니다.",
  "line": 65
 },
 {
  "speaker": "박준영",
  "start": 159.9939,
  "end": 161.2266,
  "overlap": false,
  "text": "네. 기억합니다.",
  "line": 67
 },
 {
  "speaker": "김서연",
  "start": 162.0818,
  "end": 168.1204,
  "overlap": false,
  "text": "제가 그때 동시에 여러 개가 돌면 확인해도 지나갈 수 있다고 말씀드렸고요.",
  "line": 68
 },
 {
  "speaker": "김서연",
  "start": 168.49,
  "end": 172.7534,
  "overlap": false,
  "text": "실제로 나면 그때 잡자고 정리하고 넘어갔습니다.",
  "line": 69
 },
 {
  "speaker": "박준영",
  "start": 173.2148,
  "end": 175.6948,
  "overlap": false,
  "text": "네 제가 그렇게 정리했습니다.",
  "line": 70
 },
 {
  "speaker": "박준영",
  "start": 179.0572,
  "end": 181.6447,
  "overlap": false,
  "text": "그건 제 판단이었고 틀렸습니다.",
  "line": 72
 },
 {
  "speaker": "박준영",
  "start": 181.8932,
  "end": 187.4993,
  "overlap": false,
  "text": "일정이 빠듯해서 미룬 건데, 미룬 대가가 사용자 이백십팔 명이었네요.",
  "line": 73
 },
 {
  "speaker": "김서연",
  "start": 188.1871,
  "end": 191.655,
  "overlap": false,
  "text": "저도 그때 더 세게 말씀드렸어야 했습니다.",
  "line": 74
 },
 {
  "speaker": "박준영",
  "start": 192.1428,
  "end": 195.9761,
  "overlap": false,
  "text": "아니요 서연님은 말씀하셨어요. 제가 넘긴 겁니다.",
  "line": 75
 },
 {
  "speaker": "박준영",
  "start": 199.3007,
  "end": 203.6441,
  "overlap": false,
  "text": "기록에 남겨두죠. 다음에 같은 상황이 오면 다르게 정하려고요.",
  "line": 77
 },
 {
  "speaker": "김서연",
  "start": 203.1981,
  "end": 203.4617,
  "overlap": true,
  "text": "네.",
  "line": 78
 },
 {
  "speaker": "박준영",
  "start": 206.5668,
  "end": 208.821,
  "overlap": false,
  "text": "자, 그럼 어떻게 막을지 보겠습니다.",
  "line": 80
 },
 {
  "speaker": "박준영",
  "start": 209.0398,
  "end": 210.2368,
  "overlap": false,
  "text": "지금 급한 건 뭐죠.",
  "line": 81
 },
 {
  "speaker": "이도현",
  "start": 210.9739,
  "end": 213.8003,
  "overlap": false,
  "text": "일단 스케줄러가 한 번만 돌게 하는 거요.",
  "line": 82
 },
 {
  "speaker": "김서연",
  "start": 214.4401,
  "end": 220.4137,
  "overlap": false,
  "text": "네 그건 금요일 저녁에 임시로 막아뒀습니다. 락을 하나 걸었어요.",
  "line": 83
 },
 {
  "speaker": "김서연",
  "start": 220.7169,
  "end": 223.1745,
  "overlap": false,
  "text": "근데 그건 임시입니다.",
  "line": 84
 },
 {
  "speaker": "박준영",
  "start": 223.6925,
  "end": 224.1811,
  "overlap": false,
  "text": "왜요.",
  "line": 85
 },
 {
  "speaker": "김서연",
  "start": 224.6893,
  "end": 231.3183,
  "overlap": false,
  "text": "락이 풀리는 경우가 있어요. 인스턴스가 죽으면 락이 남거나 반대로 일찍 풀립니다.",
  "line": 86
 },
 {
  "speaker": "김서연",
  "start": 231.655,
  "end": 237.0518,
  "overlap": false,
  "text": "그리고 배치가 한 번만 돌아도 그 안에서 재시도가 중복을 만들 수 있고요.",
  "line": 87
 },
 {
  "speaker": "김서연",
  "start": 239.3899,
  "end": 243.2134,
  "overlap": false,
  "text": "근본적으로는 알림 등록에 멱등키를 붙여야 됩니다.",
  "line": 89
 },
 {
  "speaker": "박준영",
  "start": 243.9536,
  "end": 245.0847,
  "overlap": false,
  "text": "그게 뭐죠.",
  "line": 90
 },
 {
  "speaker": "김서연",
  "start": 246.0373,
  "end": 251.4091,
  "overlap": false,
  "text": "같은 회차의 같은 알림은 몇 번을 넣어도 하나만 남게 하는 겁니다.",
  "line": 91
 },
 {
  "speaker": "김서연",
  "start": 251.6105,
  "end": 258.3425,
  "overlap": false,
  "text": "일정 아이디랑 회차 날짜랑 알림 종류를 합쳐서 키로 만들고, 그걸 유니크로 겁니다.",
  "line": 92
 },
 {
  "speaker": "김서연",
  "start": 258.7052,
  "end": 263.9199,
  "overlap": false,
  "text": "그러면 두 번째 넣기는 데이터베이스가 거절합니다. 코드가 뭘 잘못해도요.",
  "line": 93
 },
 {
  "speaker": "이도현",
  "start": 264.4213,
  "end": 265.9494,
  "overlap": false,
  "text": "아 그건 확실하네요.",
  "line": 94
 },
 {
  "speaker": "김서연",
  "start": 266.928,
  "end": 272.7032,
  "overlap": false,
  "text": "네. 확인하고 넣는 게 아니라 넣어보고 거절당하는 거라 경합이 안 생깁니다.",
  "line": 95
 },
 {
  "speaker": "박준영",
  "start": 275.4774,
  "end": 276.7985,
  "overlap": false,
  "text": "그거 얼마나 걸려요.",
  "line": 97
 },
 {
  "speaker": "김서연",
  "start": 277.5626,
  "end": 281.7856,
  "overlap": false,
  "text": "마이그레이션이랑 코드 고치는 거 합쳐서 이 일이요.",
  "line": 98
 },
 {
  "speaker": "김서연",
  "start": 282.1782,
  "end": 288.5424,
  "overlap": false,
  "text": "다만 기존 데이터에 중복이 남아 있어서 그거 정리하고 유니크를 걸어야 됩니다.",
  "line": 99
 },
 {
  "speaker": "박준영",
  "start": 289.4146,
  "end": 291.3226,
  "overlap": false,
  "text": "이 일이면 이번 주에 되네요.",
  "line": 100
 },
 {
  "speaker": "김서연",
  "start": 290.6276,
  "end": 290.8912,
  "overlap": true,
  "text": "네.",
  "line": 101
 },
 {
  "speaker": "박준영",
  "start": 294.7551,
  "end": 301.2993,
  "overlap": false,
  "text": "저는 지금 락 걸어둔 걸로 일단 버티고, 멱등키는 출시 후에 하는 게 어떨까 싶은데요.",
  "line": 103
 },
 {
  "speaker": "박준영",
  "start": 301.5416,
  "end": 303.721,
  "overlap": false,
  "text": "출시가 이 주 남았어서요.",
  "line": 104
 },
 {
  "speaker": "김서연",
  "start": 304.1719,
  "end": 306.3471,
  "overlap": false,
  "text": "저는 그건 반대입니다.",
  "line": 105
 },
 {
  "speaker": "박준영",
  "start": 306.8632,
  "end": 308.5119,
  "overlap": false,
  "text": "네 말씀해주세요.",
  "line": 106
 },
 {
  "speaker": "김서연",
  "start": 309.0402,
  "end": 312.7515,
  "overlap": false,
  "text": "지금 락은 같은 사고를 다시 막지 못합니다.",
  "line": 107
 },
 {
  "speaker": "김서연",
  "start": 313.1162,
  "end": 319.4527,
  "overlap": false,
  "text": "금요일 사고가 배포 중에 났는데요, 출시 전에 배포가 최소 열 번은 더 있을 거예요.",
  "line": 108
 },
 {
  "speaker": "박준영",
  "start": 319.0893,
  "end": 320.0319,
  "overlap": true,
  "text": "음.",
  "line": 109
 },
 {
  "speaker": "김서연",
  "start": 320.61,
  "end": 326.1512,
  "overlap": false,
  "text": "그리고 출시하면 반복 일정 쓰는 사용자가 지금보다 훨씬 많아집니다.",
  "line": 110
 },
 {
  "speaker": "김서연",
  "start": 326.4244,
  "end": 331.1221,
  "overlap": false,
  "text": "지금은 이백 명이 맞았는데, 출시 후면 그게 몇 천 명이 될 수 있어요.",
  "line": 111
 },
 {
  "speaker": "이도현",
  "start": 334.0318,
  "end": 335.4014,
  "overlap": false,
  "text": "그건 맞는 것 같아요.",
  "line": 113
 },
 {
  "speaker": "이도현",
  "start": 335.7927,
  "end": 340.8615,
  "overlap": false,
  "text": "저도 금요일에 CS 채널 봤는데 분위기가 안 좋았어요.",
  "line": 114
 },
 {
  "speaker": "최민지",
  "start": 341.6864,
  "end": 345.2051,
  "overlap": false,
  "text": "저도요. 한 분은 알림 자체를 다 끄셨더라고요.",
  "line": 115
 },
 {
  "speaker": "박준영",
  "start": 344.7983,
  "end": 345.3047,
  "overlap": true,
  "text": "아.",
  "line": 116
 },
 {
  "speaker": "최민지",
  "start": 346.0317,
  "end": 349.2098,
  "overlap": false,
  "text": "그러면 저희 서비스 쓰는 이유가 없어지는 거잖아요.",
  "line": 117
 },
 {
  "speaker": "박준영",
  "start": 353.0334,
  "end": 354.4807,
  "overlap": false,
  "text": "네. 알겠습니다.",
  "line": 119
 },
 {
  "speaker": "박준영",
  "start": 354.6437,
  "end": 356.6555,
  "overlap": false,
  "text": "멱등키 이번 주에 하죠.",
  "line": 120
 },
 {
  "speaker": "김서연",
  "start": 356.0156,
  "end": 356.2791,
  "overlap": true,
  "text": "네.",
  "line": 121
 },
 {
  "speaker": "박준영",
  "start": 357.2765,
  "end": 362.7612,
  "overlap": false,
  "text": "대신 범위는 알림 등록만으로 하겠습니다. 다른 데까지 넓히지 말고요.",
  "line": 122
 },
 {
  "speaker": "김서연",
  "start": 363.515,
  "end": 368.7627,
  "overlap": false,
  "text": "네 그건 동의합니다. 알림만 해도 지금 사고는 막힙니다.",
  "line": 123
 },
 {
  "speaker": "박준영",
  "start": 369.5644,
  "end": 371.2453,
  "overlap": false,
  "text": "그럼 그렇게 결정하겠습니다.",
  "line": 124
 },
 {
  "speaker": "박준영",
  "start": 374.5626,
  "end": 375.909,
  "overlap": false,
  "text": "할 일 정리하겠습니다.",
  "line": 126
 },
 {
  "speaker": "박준영",
  "start": 376.1898,
  "end": 378.0659,
  "overlap": false,
  "text": "먼저 오늘 나가야 되는 거요.",
  "line": 127
 },
 {
  "speaker": "이도현",
  "start": 378.7987,
  "end": 382.8028,
  "overlap": false,
  "text": "핫픽스요. 알림 화면에 중복된 거 안 보이게 거르는 거요.",
  "line": 128
 },
 {
  "speaker": "박준영",
  "start": 383.3217,
  "end": 384.5712,
  "overlap": false,
  "text": "그거 지금 보이나요?",
  "line": 129
 },
 {
  "speaker": "이도현",
  "start": 385.2683,
  "end": 388.9464,
  "overlap": false,
  "text": "네. 알림함에 사십 개가 그대로 쌓여 있어요.",
  "line": 130
 },
 {
  "speaker": "최민지",
  "start": 389.4216,
  "end": 391.3576,
  "overlap": false,
  "text": "아 그거 지워지는 게 아니에요?",
  "line": 131
 },
 {
  "speaker": "이도현",
  "start": 392.046,
  "end": 393.6071,
  "overlap": false,
  "text": "네 안 지워집니다.",
  "line": 132
 },
 {
  "speaker": "박준영",
  "start": 394.3288,
  "end": 396.7411,
  "overlap": false,
  "text": "그럼 그건 오늘 나가야겠네요.",
  "line": 133
 },
 {
  "speaker": "이도현",
  "start": 397.6056,
  "end": 400.4358,
  "overlap": false,
  "text": "네 제가 오늘 중으로 배포하겠습니다.",
  "line": 134
 },
 {
  "speaker": "박준영",
  "start": 401.072,
  "end": 404.7195,
  "overlap": false,
  "text": "몇 시쯤 될까요.",
  "line": 135
 },
 {
  "speaker": "이도현",
  "start": 405.1313,
  "end": 408.0785,
  "overlap": false,
  "text": "점심 전에 올리고 오후에 배포할게요.",
  "line": 136
 },
 {
  "speaker": "박준영",
  "start": 408.7951,
  "end": 410.1462,
  "overlap": false,
  "text": "네 부탁드립니다.",
  "line": 137
 },
 {
  "speaker": "박준영",
  "start": 412.3475,
  "end": 413.9411,
  "overlap": false,
  "text": "서연님 멱등키요.",
  "line": 139
 },
 {
  "speaker": "김서연",
  "start": 414.7859,
  "end": 418.659,
  "overlap": false,
  "text": "마이그레이션은 내일 올리고요, 목요일까지 배포하겠습니다.",
  "line": 140
 },
 {
  "speaker": "박준영",
  "start": 419.2922,
  "end": 419.9021,
  "overlap": false,
  "text": "구일이요?",
  "line": 141
 },
 {
  "speaker": "김서연",
  "start": 420.5304,
  "end": 422.4115,
  "overlap": false,
  "text": "네 칠월 구일.",
  "line": 142
 },
 {
  "speaker": "박준영",
  "start": 423.3572,
  "end": 423.9176,
  "overlap": false,
  "text": "좋습니다.",
  "line": 143
 },
 {
  "speaker": "김서연",
  "start": 424.5534,
  "end": 428.9081,
  "overlap": false,
  "text": "기존 중복 데이터 정리하는 스크립트도 같이 올리겠습니다.",
  "line": 144
 },
 {
  "speaker": "박준영",
  "start": 429.5174,
  "end": 429.873,
  "overlap": false,
  "text": "네.",
  "line": 145
 },
 {
  "speaker": "박준영",
  "start": 432.11,
  "end": 435.2343,
  "overlap": false,
  "text": "민지님, 안내 문구가 필요할 것 같은데요.",
  "line": 147
 },
 {
  "speaker": "최민지",
  "start": 435.9228,
  "end": 437.0403,
  "overlap": false,
  "text": "사과 문구요?",
  "line": 148
 },
 {
  "speaker": "박준영",
  "start": 437.4963,
  "end": 443.0995,
  "overlap": false,
  "text": "네. 알림함 상단에 한 줄 띄우고, CS 답변 템플릿도 있으면 좋겠어요.",
  "line": 149
 },
 {
  "speaker": "최민지",
  "start": 443.8275,
  "end": 445.2653,
  "overlap": false,
  "text": "오늘 중에 드릴게요.",
  "line": 150
 },
 {
  "speaker": "최민지",
  "start": 445.6457,
  "end": 450.1734,
  "overlap": false,
  "text": "문구는 짧게 갈게요. 뭐가 잘못됐는지랑 언제 고쳤는지만요.",
  "line": 151
 },
 {
  "speaker": "박준영",
  "start": 450.9112,
  "end": 452.7757,
  "overlap": false,
  "text": "네 그게 좋겠습니다.",
  "line": 152
 },
 {
  "speaker": "최민지",
  "start": 453.622,
  "end": 456.0961,
  "overlap": false,
  "text": "도현님 핫픽스에 같이 들어가야 되나요?",
  "line": 153
 },
 {
  "speaker": "이도현",
  "start": 457.0644,
  "end": 461.1256,
  "overlap": false,
  "text": "문구는 나중에 넣어도 돼요. 오늘 급한 건 거르는 거라서요.",
  "line": 154
 },
 {
  "speaker": "최민지",
  "start": 462.0309,
  "end": 462.7045,
  "overlap": false,
  "text": "아 네.",
  "line": 155
 },
 {
  "speaker": "박준영",
  "start": 465.5509,
  "end": 470.3914,
  "overlap": false,
  "text": "저는 영향받은 이백십팔 명 목록 정리해서 CS팀에 넘기겠습니다.",
  "line": 157
 },
 {
  "speaker": "박준영",
  "start": 470.7447,
  "end": 472.9761,
  "overlap": false,
  "text": "내일 오전까지 하겠습니다.",
  "line": 158
 },
 {
  "speaker": "김서연",
  "start": 473.8682,
  "end": 476.8721,
  "overlap": false,
  "text": "목록은 제가 뽑아서 오늘 드릴게요.",
  "line": 159
 },
 {
  "speaker": "박준영",
  "start": 477.4244,
  "end": 478.9222,
  "overlap": false,
  "text": "아 네 감사합니다.",
  "line": 160
 },
 {
  "speaker": "박준영",
  "start": 482.1927,
  "end": 483.2433,
  "overlap": false,
  "text": "하나 더 있는데요.",
  "line": 162
 },
 {
  "speaker": "박준영",
  "start": 483.479,
  "end": 488.9002,
  "overlap": false,
  "text": "이번 건이 배포 중에 인스턴스 두 개가 스케줄러를 같이 돌려서 난 거잖아요.",
  "line": 163
 },
 {
  "speaker": "김서연",
  "start": 488.4693,
  "end": 488.7329,
  "overlap": true,
  "text": "네.",
  "line": 164
 },
 {
  "speaker": "박준영",
  "start": 489.6431,
  "end": 493.4063,
  "overlap": false,
  "text": "그건 알림 말고 다른 배치도 똑같은 거 아닌가요.",
  "line": 165
 },
 {
  "speaker": "김서연",
  "start": 493.997,
  "end": 498.8851,
  "overlap": false,
  "text": "맞습니다. 배치가 지금 네 개 있는데 전부 같은 구조예요.",
  "line": 166
 },
 {
  "speaker": "박준영",
  "start": 498.2758,
  "end": 499.2184,
  "overlap": true,
  "text": "음.",
  "line": 167
 },
 {
  "speaker": "김서연",
  "start": 499.9678,
  "end": 505.4573,
  "overlap": false,
  "text": "근데 나머지 셋은 중복으로 돌아도 결과가 같아서 티가 안 났던 겁니다.",
  "line": 168
 },
 {
  "speaker": "박준영",
  "start": 505.9199,
  "end": 507.6779,
  "overlap": false,
  "text": "그럼 언젠가는 터지겠네요.",
  "line": 169
 },
 {
  "speaker": "김서연",
  "start": 508.3434,
  "end": 510.1876,
  "overlap": false,
  "text": "네 그럴 수 있습니다.",
  "line": 170
 },
 {
  "speaker": "박준영",
  "start": 510.8215,
  "end": 515.063,
  "overlap": false,
  "text": "그건 이번 주 범위는 아니고요, 출시 끝나고 따로 보죠.",
  "line": 171
 },
 {
  "speaker": "김서연",
  "start": 515.887,
  "end": 520.0878,
  "overlap": false,
  "text": "네 그게 맞을 것 같습니다. 백로그에 올려두겠습니다.",
  "line": 172
 },
 {
  "speaker": "박준영",
  "start": 520.5407,
  "end": 521.8917,
  "overlap": false,
  "text": "네 부탁드립니다.",
  "line": 173
 },
 {
  "speaker": "박준영",
  "start": 525.0839,
  "end": 526.3739,
  "overlap": false,
  "text": "그럼 정리하겠습니다.",
  "line": 175
 },
 {
  "speaker": "박준영",
  "start": 526.652,
  "end": 532.2187,
  "overlap": false,
  "text": "원인은 배포 중 스케줄러 중복 실행이고, 확인 후 삽입 방식이 경합을 못 막았다.",
  "line": 176
 },
 {
  "speaker": "박준영",
  "start": 532.4698,
  "end": 535.4166,
  "overlap": false,
  "text": "조치는 멱등키. 이번 주 목요일까지.",
  "line": 177
 },
 {
  "speaker": "박준영",
  "start": 535.7329,
  "end": 540.514,
  "overlap": false,
  "text": "오늘은 도현님 핫픽스, 민지님 안내 문구, 저는 영향 사용자 정리.",
  "line": 178
 },
 {
  "speaker": "김서연",
  "start": 541.1137,
  "end": 541.3773,
  "overlap": false,
  "text": "네.",
  "line": 179
 },
 {
  "speaker": "최민지",
  "start": 541.8956,
  "end": 542.2712,
  "overlap": false,
  "text": "네.",
  "line": 180
 },
 {
  "speaker": "이도현",
  "start": 543.2303,
  "end": 543.503,
  "overlap": false,
  "text": "넵.",
  "line": 181
 },
 {
  "speaker": "박준영",
  "start": 544.0493,
  "end": 550.5283,
  "overlap": false,
  "text": "그리고 이 주 전에 미룬 결정이 이번 사고로 이어졌다는 것도 회고 문서에 남기겠습니다.",
  "line": 182
 },
 {
  "speaker": "김서연",
  "start": 551.0165,
  "end": 552.5241,
  "overlap": false,
  "text": "네 감사합니다.",
  "line": 183
 },
 {
  "speaker": "박준영",
  "start": 553.092,
  "end": 554.1558,
  "overlap": false,
  "text": "수고하셨습니다.",
  "line": 184
 },
 {
  "speaker": "최민지",
  "start": 554.7596,
  "end": 555.6342,
  "overlap": false,
  "text": "수고하셨습니다.",
  "line": 185
 },
 {
  "speaker": "이도현",
  "start": 555.2216,
  "end": 556.0411,
  "overlap": true,
  "text": "수고하셨어요.",
  "line": 186
 },
 {
  "speaker": "김서연",
  "start": 556.7629,
  "end": 558.3098,
  "overlap": false,
  "text": "네 수고하셨습니다.",
  "line": 187
 }
]
