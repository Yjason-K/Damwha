[
 {
  "speaker": "박준영",
  "start": 0.0,
  "end": 5.39,
  "overlap": false,
  "text": "시작하겠습니다. 출시가 다음 주 월요일이라 오늘은 점검 위주로 가겠습니다.",
  "line": 13
 },
 {
  "speaker": "박준영",
  "start": 5.7758,
  "end": 10.4976,
  "overlap": false,
  "text": "지난 회의들에서 나온 것부터 하나씩 확인하고, 남은 게 있으면 정리하죠.",
  "line": 14
 },
 {
  "speaker": "김서연",
  "start": 9.9419,
  "end": 10.2055,
  "overlap": true,
  "text": "네.",
  "line": 15
 },
 {
  "speaker": "박준영",
  "start": 13.4833,
  "end": 17.8796,
  "overlap": false,
  "text": "먼저 멱등키요. 지난 회고에서 목요일까지였는데요.",
  "line": 17
 },
 {
  "speaker": "김서연",
  "start": 18.3281,
  "end": 21.1864,
  "overlap": false,
  "text": "구일에 배포했습니다. 예정대로요.",
  "line": 18
 },
 {
  "speaker": "박준영",
  "start": 21.9508,
  "end": 24.6134,
  "overlap": false,
  "text": "그 뒤로 중복 발생한 거 있나요.",
  "line": 19
 },
 {
  "speaker": "김서연",
  "start": 25.2393,
  "end": 26.0241,
  "overlap": false,
  "text": "없습니다.",
  "line": 20
 },
 {
  "speaker": "김서연",
  "start": 26.3746,
  "end": 33.9236,
  "overlap": false,
  "text": "그리고 그 사이에 배포가 일곱 번 있었는데, 그중에 두 번은 롤링 중에 스케줄러가 겹쳤습니다.",
  "line": 21
 },
 {
  "speaker": "박준영",
  "start": 34.4283,
  "end": 36.4624,
  "overlap": false,
  "text": "겹쳤는데 중복은 없었고요?",
  "line": 22
 },
 {
  "speaker": "김서연",
  "start": 37.3854,
  "end": 43.555,
  "overlap": false,
  "text": "네. 두 번째 삽입이 데이터베이스에서 거절됐습니다. 로그에 남아 있어요.",
  "line": 23
 },
 {
  "speaker": "이도현",
  "start": 44.2814,
  "end": 46.2573,
  "overlap": false,
  "text": "오 그럼 진짜 막힌 거네요.",
  "line": 24
 },
 {
  "speaker": "김서연",
  "start": 47.1986,
  "end": 50.9496,
  "overlap": false,
  "text": "네. 그날 안 했으면 두 번 더 터졌을 겁니다.",
  "line": 25
 },
 {
  "speaker": "박준영",
  "start": 54.6359,
  "end": 58.1976,
  "overlap": false,
  "text": "네. 그때 서연님 말씀 듣기를 잘했습니다.",
  "line": 27
 },
 {
  "speaker": "김서연",
  "start": 58.8559,
  "end": 59.5763,
  "overlap": false,
  "text": "아닙니다.",
  "line": 28
 },
 {
  "speaker": "박준영",
  "start": 60.4497,
  "end": 62.2615,
  "overlap": false,
  "text": "기존 중복 데이터 정리는요.",
  "line": 29
 },
 {
  "speaker": "김서연",
  "start": 63.252,
  "end": 69.9806,
  "overlap": false,
  "text": "같이 돌렸습니다. 삼천사백십이 건 중에 유효한 이백십팔 건만 남기고 지웠습니다.",
  "line": 30
 },
 {
  "speaker": "박준영",
  "start": 70.6024,
  "end": 71.1629,
  "overlap": false,
  "text": "좋습니다.",
  "line": 31
 },
 {
  "speaker": "박준영",
  "start": 73.5551,
  "end": 77.8726,
  "overlap": false,
  "text": "다음은 조회 성능이요. 이십육일에 벤치마크 주셨죠.",
  "line": 33
 },
 {
  "speaker": "김서연",
  "start": 78.83,
  "end": 79.0936,
  "overlap": false,
  "text": "네.",
  "line": 34
 },
 {
  "speaker": "김서연",
  "start": 79.288,
  "end": 82.6603,
  "overlap": false,
  "text": "결과부터 말씀드리면 예상보다 느렸습니다.",
  "line": 35
 },
 {
  "speaker": "박준영",
  "start": 83.4256,
  "end": 84.0249,
  "overlap": false,
  "text": "얼마나요.",
  "line": 36
 },
 {
  "speaker": "김서연",
  "start": 84.8478,
  "end": 90.3349,
  "overlap": false,
  "text": "반복 일정 백 개 기준으로 한 달치 조회에 사백 밀리초 나왔습니다.",
  "line": 37
 },
 {
  "speaker": "이도현",
  "start": 91.3006,
  "end": 93.2127,
  "overlap": false,
  "text": "사백이면 좀 느린데요.",
  "line": 38
 },
 {
  "speaker": "김서연",
  "start": 94.0121,
  "end": 96.4672,
  "overlap": false,
  "text": "네. 목표가 백 밀리초였으니까요.",
  "line": 39
 },
 {
  "speaker": "박준영",
  "start": 96.9472,
  "end": 99.2249,
  "overlap": false,
  "text": "그래서 캐시 넣으셨나요.",
  "line": 40
 },
 {
  "speaker": "김서연",
  "start": 99.9236,
  "end": 102.6734,
  "overlap": false,
  "text": "넣었습니다. 지난주 화요일에요.",
  "line": 41
 },
 {
  "speaker": "김서연",
  "start": 102.9468,
  "end": 107.8066,
  "overlap": false,
  "text": "지금은 육십 밀리초 나옵니다. 캐시 미스일 때만 사백이고요.",
  "line": 42
 },
 {
  "speaker": "박준영",
  "start": 108.5067,
  "end": 110.2648,
  "overlap": false,
  "text": "캐시 미스가 얼마나 나요.",
  "line": 43
 },
 {
  "speaker": "김서연",
  "start": 111.2399,
  "end": 116.7617,
  "overlap": false,
  "text": "처음 열 때 한 번이요. 그 뒤로는 규칙이 바뀔 때만 무효화됩니다.",
  "line": 44
 },
 {
  "speaker": "박준영",
  "start": 117.3717,
  "end": 120.3632,
  "overlap": false,
  "text": "그럼 실사용에서는 거의 안 나겠네요.",
  "line": 45
 },
 {
  "speaker": "김서연",
  "start": 119.9513,
  "end": 120.2149,
  "overlap": true,
  "text": "네.",
  "line": 46
 },
 {
  "speaker": "박준영",
  "start": 123.0765,
  "end": 124.7145,
  "overlap": false,
  "text": "도현님 API 스펙은요.",
  "line": 48
 },
 {
  "speaker": "이도현",
  "start": 125.4992,
  "end": 130.5105,
  "overlap": false,
  "text": "그거 이십육일에 올렸고요, 서연님이랑 맞춰서 아이디 형식 확정했습니다.",
  "line": 49
 },
 {
  "speaker": "이도현",
  "start": 130.8953,
  "end": 134.5219,
  "overlap": false,
  "text": "반복 아이디에 언더바 붙이고 날짜 붙이는 걸로요.",
  "line": 50
 },
 {
  "speaker": "김서연",
  "start": 135.2711,
  "end": 137.591,
  "overlap": false,
  "text": "네 그대로 구현됐습니다.",
  "line": 51
 },
 {
  "speaker": "이도현",
  "start": 138.1517,
  "end": 142.8158,
  "overlap": false,
  "text": "파싱 함수도 한 군데로 모았어요. 화면 여기저기 안 퍼졌습니다.",
  "line": 52
 },
 {
  "speaker": "박준영",
  "start": 143.7737,
  "end": 144.426,
  "overlap": false,
  "text": "좋네요.",
  "line": 53
 },
 {
  "speaker": "박준영",
  "start": 146.6989,
  "end": 151.4403,
  "overlap": false,
  "text": "예외 처리 화면은요. 이번 것만 바꿀지 전체 바꿀지 묻는 거요.",
  "line": 55
 },
 {
  "speaker": "최민지",
  "start": 152.2458,
  "end": 155.7008,
  "overlap": false,
  "text": "그건 붙었고요, 도현님이 지난주에 구현하셨어요.",
  "line": 56
 },
 {
  "speaker": "이도현",
  "start": 156.3864,
  "end": 157.8068,
  "overlap": false,
  "text": "네 다 됐습니다.",
  "line": 57
 },
 {
  "speaker": "최민지",
  "start": 158.337,
  "end": 161.5527,
  "overlap": false,
  "text": "저도 확인했어요. 문구만 한 번 다듬었고요.",
  "line": 58
 },
 {
  "speaker": "박준영",
  "start": 162.3682,
  "end": 163.3288,
  "overlap": false,
  "text": "네 좋습니다.",
  "line": 59
 },
 {
  "speaker": "박준영",
  "start": 166.6715,
  "end": 171.3429,
  "overlap": false,
  "text": "그럼 남은 게 접근성인데요. 민지님 그거 칠월 일일까지였죠.",
  "line": 61
 },
 {
  "speaker": "최민지",
  "start": 171.8574,
  "end": 174.3447,
  "overlap": false,
  "text": "네. 그게 제가 드릴 말씀이 있습니다.",
  "line": 62
 },
 {
  "speaker": "박준영",
  "start": 175.0206,
  "end": 176.6277,
  "overlap": false,
  "text": "네 말씀하세요.",
  "line": 63
 },
 {
  "speaker": "최민지",
  "start": 179.2448,
  "end": 182.614,
  "overlap": false,
  "text": "검토는 일일에 끝냈고요, 문제가 두 개 나왔습니다.",
  "line": 65
 },
 {
  "speaker": "최민지",
  "start": 182.8067,
  "end": 185.656,
  "overlap": false,
  "text": "그런데 그중에 하나가 아직 안 고쳐졌어요.",
  "line": 66
 },
 {
  "speaker": "박준영",
  "start": 186.1888,
  "end": 186.9314,
  "overlap": false,
  "text": "어떤 건가요.",
  "line": 67
 },
 {
  "speaker": "최민지",
  "start": 187.9089,
  "end": 191.7824,
  "overlap": false,
  "text": "요일 선택이요. 월화수목금토일 칩 일곱 개 있잖아요.",
  "line": 68
 },
 {
  "speaker": "박준영",
  "start": 191.0403,
  "end": 191.3959,
  "overlap": true,
  "text": "네.",
  "line": 69
 },
 {
  "speaker": "최민지",
  "start": 192.4118,
  "end": 194.8832,
  "overlap": false,
  "text": "그게 키보드로 접근이 안 됩니다.",
  "line": 70
 },
 {
  "speaker": "이도현",
  "start": 195.7269,
  "end": 197.1319,
  "overlap": false,
  "text": "탭으로 안 가나요?",
  "line": 71
 },
 {
  "speaker": "최민지",
  "start": 197.5571,
  "end": 200.2919,
  "overlap": false,
  "text": "탭으로는 가는데 스페이스로 선택이 안 돼요.",
  "line": 72
 },
 {
  "speaker": "최민지",
  "start": 200.6707,
  "end": 207.4423,
  "overlap": false,
  "text": "그리고 스크린리더가 선택 상태를 안 읽습니다. 월요일이 켜져 있는지 꺼져 있는지 모릅니다.",
  "line": 73
 },
 {
  "speaker": "이도현",
  "start": 211.1646,
  "end": 215.2634,
  "overlap": false,
  "text": "아 그거 제가 버튼으로 안 만들고 디브로 만들었어요.",
  "line": 75
 },
 {
  "speaker": "이도현",
  "start": 215.6185,
  "end": 217.3134,
  "overlap": false,
  "text": "스타일 맞추기가 편해서요.",
  "line": 76
 },
 {
  "speaker": "최민지",
  "start": 217.879,
  "end": 219.7902,
  "overlap": false,
  "text": "네 그것 때문인 것 같아요.",
  "line": 77
 },
 {
  "speaker": "박준영",
  "start": 220.4159,
  "end": 222.8633,
  "overlap": false,
  "text": "그거 고치는 데 얼마나 걸려요.",
  "line": 78
 },
 {
  "speaker": "이도현",
  "start": 223.4721,
  "end": 227.4371,
  "overlap": false,
  "text": "어... 마크업 바꾸고 상태 속성 붙이면 하루면 될 것 같은데요.",
  "line": 79
 },
 {
  "speaker": "이도현",
  "start": 227.8302,
  "end": 231.6477,
  "overlap": false,
  "text": "근데 스타일이 좀 깨질 수 있어요. 확인을 해봐야 됩니다.",
  "line": 80
 },
 {
  "speaker": "최민지",
  "start": 234.3054,
  "end": 235.7206,
  "overlap": false,
  "text": "그리고 하나 더 있는데요.",
  "line": 82
 },
 {
  "speaker": "최민지",
  "start": 235.9955,
  "end": 242.2296,
  "overlap": false,
  "text": "제가 지난주에 실제 사용자 한 분께 테스트를 부탁드렸어요. 스크린리더 쓰시는 분이요.",
  "line": 83
 },
 {
  "speaker": "박준영",
  "start": 243.2032,
  "end": 244.5418,
  "overlap": false,
  "text": "아 그러셨어요?",
  "line": 84
 },
 {
  "speaker": "최민지",
  "start": 245.4837,
  "end": 248.7447,
  "overlap": false,
  "text": "네. 커뮤니티에서 도와주신다는 분이 계셔서요.",
  "line": 85
 },
 {
  "speaker": "최민지",
  "start": 248.9935,
  "end": 252.1812,
  "overlap": false,
  "text": "그분이 반복 일정을 끝까지 못 만드셨습니다.",
  "line": 86
 },
 {
  "speaker": "박준영",
  "start": 255.7656,
  "end": 256.9631,
  "overlap": false,
  "text": "못 만드셨다고요?",
  "line": 88
 },
 {
  "speaker": "최민지",
  "start": 257.8473,
  "end": 259.8128,
  "overlap": false,
  "text": "네. 요일에서 막히셨어요.",
  "line": 89
 },
 {
  "speaker": "최민지",
  "start": 259.9897,
  "end": 266.3553,
  "overlap": false,
  "text": "그리고 종료 조건 라디오 버튼도 그룹으로 안 묶여 있어서 뭘 고르는 건지 모르겠다고 하셨고요.",
  "line": 90
 },
 {
  "speaker": "이도현",
  "start": 265.8592,
  "end": 266.2926,
  "overlap": true,
  "text": "아.",
  "line": 91
 },
 {
  "speaker": "최민지",
  "start": 267.2812,
  "end": 271.1039,
  "overlap": false,
  "text": "그래서 저는 이 상태로 나가면 안 된다고 봅니다.",
  "line": 92
 },
 {
  "speaker": "박준영",
  "start": 275.0545,
  "end": 275.9971,
  "overlap": false,
  "text": "음.",
  "line": 94
 },
 {
  "speaker": "박준영",
  "start": 276.2055,
  "end": 278.4986,
  "overlap": false,
  "text": "근데 출시가 다음 주 월요일이에요.",
  "line": 95
 },
 {
  "speaker": "최민지",
  "start": 278.9458,
  "end": 280.2694,
  "overlap": false,
  "text": "네 알고 있습니다.",
  "line": 96
 },
 {
  "speaker": "박준영",
  "start": 281.142,
  "end": 285.5868,
  "overlap": false,
  "text": "마케팅 메일이 이미 잡혀 있고요, 블로그 글도 예약돼 있습니다.",
  "line": 97
 },
 {
  "speaker": "최민지",
  "start": 286.3599,
  "end": 288.0016,
  "overlap": false,
  "text": "그것도 알고 있어요.",
  "line": 98
 },
 {
  "speaker": "박준영",
  "start": 290.5441,
  "end": 294.5115,
  "overlap": false,
  "text": "도현님 말씀대로 하루면 되는 거면 이번 주에 넣으면 되지 않나요.",
  "line": 100
 },
 {
  "speaker": "이도현",
  "start": 295.215,
  "end": 296.9388,
  "overlap": false,
  "text": "요일 칩은 하루면 돼요.",
  "line": 101
 },
 {
  "speaker": "이도현",
  "start": 297.1067,
  "end": 302.9939,
  "overlap": false,
  "text": "근데 종료 조건까지 하면 이틀이고요, 그러고 나서 다시 테스트를 받아야 되잖아요.",
  "line": 102
 },
 {
  "speaker": "최민지",
  "start": 303.814,
  "end": 305.1333,
  "overlap": false,
  "text": "네 그게 문제예요.",
  "line": 103
 },
 {
  "speaker": "최민지",
  "start": 305.415,
  "end": 310.4348,
  "overlap": false,
  "text": "고치고 나서 그분께 다시 봐달라고 해야 되는데, 그분도 시간이 있으셔야 되고요.",
  "line": 104
 },
 {
  "speaker": "최민지",
  "start": 310.761,
  "end": 314.343,
  "overlap": false,
  "text": "이번 주 안에 고치고 테스트까지 끝나는 건 어렵습니다.",
  "line": 105
 },
 {
  "speaker": "박준영",
  "start": 317.7959,
  "end": 322.1123,
  "overlap": false,
  "text": "그러면 일단 출시하고 바로 다음 주에 고치는 건 어떨까요.",
  "line": 107
 },
 {
  "speaker": "최민지",
  "start": 322.8992,
  "end": 324.0637,
  "overlap": false,
  "text": "저는 반대입니다.",
  "line": 108
 },
 {
  "speaker": "박준영",
  "start": 323.5785,
  "end": 323.9341,
  "overlap": true,
  "text": "네.",
  "line": 109
 },
 {
  "speaker": "최민지",
  "start": 324.7633,
  "end": 327.1402,
  "overlap": false,
  "text": "이건 버그가 아니라 못 쓰는 겁니다.",
  "line": 110
 },
 {
  "speaker": "최민지",
  "start": 327.3741,
  "end": 333.1453,
  "overlap": false,
  "text": "반복 일정이 이번 출시의 전부인데, 어떤 사용자는 그 기능을 아예 못 씁니다.",
  "line": 111
 },
 {
  "speaker": "최민지",
  "start": 333.4538,
  "end": 337.1271,
  "overlap": false,
  "text": "그 상태로 마케팅 메일을 보내는 건 좀 아닌 것 같아요.",
  "line": 112
 },
 {
  "speaker": "김서연",
  "start": 339.8681,
  "end": 341.6944,
  "overlap": false,
  "text": "저도 민지님 쪽입니다.",
  "line": 114
 },
 {
  "speaker": "박준영",
  "start": 341.0858,
  "end": 341.4414,
  "overlap": true,
  "text": "네.",
  "line": 115
 },
 {
  "speaker": "김서연",
  "start": 342.1324,
  "end": 346.0405,
  "overlap": false,
  "text": "이 주 전에 알림 미룬 것도 같은 모양이었어요.",
  "line": 116
 },
 {
  "speaker": "김서연",
  "start": 346.2468,
  "end": 351.6491,
  "overlap": false,
  "text": "지금 급하니까 나중에 하자. 그런데 나중은 더 급했습니다.",
  "line": 117
 },
 {
  "speaker": "박준영",
  "start": 355.0922,
  "end": 356.0349,
  "overlap": false,
  "text": "음.",
  "line": 119
 },
 {
  "speaker": "이도현",
  "start": 356.6649,
  "end": 360.7215,
  "overlap": false,
  "text": "저도 사실 좀 찔리긴 해요. 제가 디브로 만든 거라서요.",
  "line": 120
 },
 {
  "speaker": "최민지",
  "start": 361.4101,
  "end": 366.3658,
  "overlap": false,
  "text": "그건 도현님 잘못이 아니에요. 저희가 접근성을 스프린트에 안 넣었던 거죠.",
  "line": 121
 },
 {
  "speaker": "박준영",
  "start": 369.8332,
  "end": 371.2805,
  "overlap": false,
  "text": "네. 알겠습니다.",
  "line": 123
 },
 {
  "speaker": "박준영",
  "start": 371.5974,
  "end": 374.3385,
  "overlap": false,
  "text": "일주일 미루죠. 팔월 삼일로 하겠습니다.",
  "line": 124
 },
 {
  "speaker": "최민지",
  "start": 375.0309,
  "end": 375.8379,
  "overlap": false,
  "text": "감사합니다.",
  "line": 125
 },
 {
  "speaker": "박준영",
  "start": 376.5381,
  "end": 382.0484,
  "overlap": false,
  "text": "마케팅은 제가 조정하겠습니다. 메일 발송일 옮기고 블로그 예약 풀겠습니다.",
  "line": 126
 },
 {
  "speaker": "박준영",
  "start": 382.3478,
  "end": 384.3739,
  "overlap": false,
  "text": "그건 오늘 중으로 하겠습니다.",
  "line": 127
 },
 {
  "speaker": "김서연",
  "start": 383.6065,
  "end": 383.87,
  "overlap": true,
  "text": "네.",
  "line": 128
 },
 {
  "speaker": "박준영",
  "start": 387.1272,
  "end": 388.994,
  "overlap": false,
  "text": "대신 조건이 하나 있습니다.",
  "line": 130
 },
 {
  "speaker": "박준영",
  "start": 389.1674,
  "end": 393.091,
  "overlap": false,
  "text": "팔월 삼일은 고정으로 가겠습니다. 이번에 미룬 걸로 끝냅니다.",
  "line": 131
 },
 {
  "speaker": "최민지",
  "start": 393.5789,
  "end": 394.964,
  "overlap": false,
  "text": "네 그건 동의해요.",
  "line": 132
 },
 {
  "speaker": "이도현",
  "start": 395.7803,
  "end": 396.0946,
  "overlap": false,
  "text": "네.",
  "line": 133
 },
 {
  "speaker": "박준영",
  "start": 396.6882,
  "end": 400.0565,
  "overlap": false,
  "text": "그 안에 못 들어가는 건 출시 후로 미루고요.",
  "line": 134
 },
 {
  "speaker": "최민지",
  "start": 399.3789,
  "end": 399.7544,
  "overlap": true,
  "text": "네.",
  "line": 135
 },
 {
  "speaker": "박준영",
  "start": 403.7629,
  "end": 405.7659,
  "overlap": false,
  "text": "그럼 할 일 정리하겠습니다.",
  "line": 137
 },
 {
  "speaker": "박준영",
  "start": 406.0108,
  "end": 410.3307,
  "overlap": false,
  "text": "민지님, 수정안 먼저 주셔야 도현님이 작업하실 수 있죠.",
  "line": 138
 },
 {
  "speaker": "최민지",
  "start": 411.1744,
  "end": 416.1075,
  "overlap": false,
  "text": "네. 요일 칩이랑 종료 조건 두 개 수정안 만들겠습니다.",
  "line": 139
 },
 {
  "speaker": "최민지",
  "start": 416.3032,
  "end": 419.0522,
  "overlap": false,
  "text": "수요일까지 드릴게요. 이십이일이요.",
  "line": 140
 },
 {
  "speaker": "박준영",
  "start": 419.6231,
  "end": 421.3696,
  "overlap": false,
  "text": "네 이십이일.",
  "line": 141
 },
 {
  "speaker": "박준영",
  "start": 423.5926,
  "end": 425.177,
  "overlap": false,
  "text": "도현님 구현이요.",
  "line": 143
 },
 {
  "speaker": "이도현",
  "start": 425.8262,
  "end": 428.9539,
  "overlap": false,
  "text": "민지님 안 받고 목금 이틀 쓰면 될 것 같아요.",
  "line": 144
 },
 {
  "speaker": "박준영",
  "start": 429.8982,
  "end": 430.7593,
  "overlap": false,
  "text": "금요일까지요?",
  "line": 145
 },
 {
  "speaker": "이도현",
  "start": 431.6468,
  "end": 433.7072,
  "overlap": false,
  "text": "네 이십사일까지 하겠습니다.",
  "line": 146
 },
 {
  "speaker": "박준영",
  "start": 434.6002,
  "end": 438.0321,
  "overlap": false,
  "text": "그럼 다음 주 월요일에 테스트 요청 드리면 되겠네요.",
  "line": 147
 },
 {
  "speaker": "최민지",
  "start": 438.8108,
  "end": 443.0013,
  "overlap": false,
  "text": "네 그분께 다음 주 화요일이나 수요일로 여쭤볼게요.",
  "line": 148
 },
 {
  "speaker": "박준영",
  "start": 443.4062,
  "end": 444.7573,
  "overlap": false,
  "text": "네 부탁드립니다.",
  "line": 149
 },
 {
  "speaker": "박준영",
  "start": 446.9788,
  "end": 449.7011,
  "overlap": false,
  "text": "그리고 저는 오늘 중으로 연기 공지하겠습니다.",
  "line": 151
 },
 {
  "speaker": "박준영",
  "start": 449.9765,
  "end": 452.1053,
  "overlap": false,
  "text": "팀 채널이랑 마케팅 쪽 둘 다요.",
  "line": 152
 },
 {
  "speaker": "최민지",
  "start": 451.3561,
  "end": 451.7316,
  "overlap": true,
  "text": "네.",
  "line": 153
 },
 {
  "speaker": "박준영",
  "start": 455.7236,
  "end": 457.8539,
  "overlap": false,
  "text": "서연님은 남은 게 없으신가요.",
  "line": 155
 },
 {
  "speaker": "김서연",
  "start": 458.5842,
  "end": 460.2995,
  "overlap": false,
  "text": "하나 하고 싶은 게 있는데요.",
  "line": 156
 },
 {
  "speaker": "박준영",
  "start": 459.5752,
  "end": 459.9308,
  "overlap": true,
  "text": "네.",
  "line": 157
 },
 {
  "speaker": "김서연",
  "start": 460.9043,
  "end": 462.4385,
  "overlap": false,
  "text": "배치 모니터링이요.",
  "line": 158
 },
 {
  "speaker": "김서연",
  "start": 462.7755,
  "end": 466.9415,
  "overlap": false,
  "text": "지금 스케줄러가 몇 번 돌았는지 대시보드에 안 보입니다.",
  "line": 159
 },
 {
  "speaker": "김서연",
  "start": 467.2403,
  "end": 470.7898,
  "overlap": false,
  "text": "지난번에도 로그를 뒤져서 알았거든요.",
  "line": 160
 },
 {
  "speaker": "박준영",
  "start": 471.505,
  "end": 473.0495,
  "overlap": false,
  "text": "아 그러네요.",
  "line": 161
 },
 {
  "speaker": "김서연",
  "start": 473.8274,
  "end": 479.3419,
  "overlap": false,
  "text": "출시하면 사용자가 늘어나니까 그건 보이는 게 좋을 것 같습니다.",
  "line": 162
 },
 {
  "speaker": "박준영",
  "start": 480.0328,
  "end": 481.3539,
  "overlap": false,
  "text": "그거 얼마나 걸려요.",
  "line": 163
 },
 {
  "speaker": "김서연",
  "start": 481.8217,
  "end": 486.7346,
  "overlap": false,
  "text": "반나절이요. 이미 있는 대시보드에 그래프 두 개 붙이는 거라서요.",
  "line": 164
 },
 {
  "speaker": "박준영",
  "start": 487.6727,
  "end": 488.5509,
  "overlap": false,
  "text": "그럼 하시죠.",
  "line": 165
 },
 {
  "speaker": "김서연",
  "start": 489.5327,
  "end": 494.4262,
  "overlap": false,
  "text": "네. 출시 전날까지 붙여두겠습니다. 팔월 이일이요.",
  "line": 166
 },
 {
  "speaker": "박준영",
  "start": 495.3261,
  "end": 496.2867,
  "overlap": false,
  "text": "네 좋습니다.",
  "line": 167
 },
 {
  "speaker": "박준영",
  "start": 498.5251,
  "end": 501.8578,
  "overlap": false,
  "text": "그리고 지난번에 백로그에 올리신 배치 네 개 건은요.",
  "line": 169
 },
 {
  "speaker": "김서연",
  "start": 502.6381,
  "end": 505.3414,
  "overlap": false,
  "text": "그건 출시 후로 그대로 뒀습니다.",
  "line": 170
 },
 {
  "speaker": "박준영",
  "start": 506.2039,
  "end": 509.0866,
  "overlap": false,
  "text": "네 그건 출시 끝나고 보죠.",
  "line": 171
 },
 {
  "speaker": "김서연",
  "start": 508.7555,
  "end": 509.019,
  "overlap": true,
  "text": "네.",
  "line": 172
 },
 {
  "speaker": "박준영",
  "start": 512.9603,
  "end": 514.2502,
  "overlap": false,
  "text": "그럼 정리하겠습니다.",
  "line": 174
 },
 {
  "speaker": "박준영",
  "start": 514.4214,
  "end": 519.6681,
  "overlap": false,
  "text": "출시를 팔월 삼일로 일주일 연기합니다. 사유는 접근성 미완입니다.",
  "line": 175
 },
 {
  "speaker": "박준영",
  "start": 520.0531,
  "end": 526.3835,
  "overlap": false,
  "text": "민지님 수정안 이십이일, 도현님 구현 이십사일, 사용자 테스트는 다음 주 중반.",
  "line": 176
 },
 {
  "speaker": "박준영",
  "start": 526.5939,
  "end": 530.8793,
  "overlap": false,
  "text": "서연님 모니터링 대시보드 팔월 이일. 저는 연기 공지 오늘.",
  "line": 177
 },
 {
  "speaker": "최민지",
  "start": 531.8572,
  "end": 532.2327,
  "overlap": false,
  "text": "네.",
  "line": 178
 },
 {
  "speaker": "김서연",
  "start": 532.7719,
  "end": 534.0917,
  "overlap": false,
  "text": "네 알겠습니다.",
  "line": 179
 },
 {
  "speaker": "이도현",
  "start": 534.8129,
  "end": 535.0856,
  "overlap": false,
  "text": "넵.",
  "line": 180
 },
 {
  "speaker": "박준영",
  "start": 535.9845,
  "end": 540.949,
  "overlap": false,
  "text": "다음 회의는 이십칠일 월요일에 하겠습니다. 그때 최종 판단하죠.",
  "line": 181
 },
 {
  "speaker": "박준영",
  "start": 543.3459,
  "end": 547.9034,
  "overlap": false,
  "text": "그리고 민지님, 테스트 도와주신 분께 감사 인사 좀 전해주세요.",
  "line": 183
 },
 {
  "speaker": "최민지",
  "start": 548.7268,
  "end": 550.0118,
  "overlap": false,
  "text": "네 그렇게 할게요.",
  "line": 184
 },
 {
  "speaker": "박준영",
  "start": 550.9126,
  "end": 553.1492,
  "overlap": false,
  "text": "덕분에 사고 하나 막았네요.",
  "line": 185
 },
 {
  "speaker": "최민지",
  "start": 553.7843,
  "end": 555.4676,
  "overlap": false,
  "text": "네 저도 그렇게 생각해요.",
  "line": 186
 },
 {
  "speaker": "박준영",
  "start": 556.318,
  "end": 557.3818,
  "overlap": false,
  "text": "수고하셨습니다.",
  "line": 187
 },
 {
  "speaker": "최민지",
  "start": 558.0126,
  "end": 558.8872,
  "overlap": false,
  "text": "수고하셨습니다.",
  "line": 188
 },
 {
  "speaker": "이도현",
  "start": 558.1223,
  "end": 558.9417,
  "overlap": true,
  "text": "수고하셨어요.",
  "line": 189
 },
 {
  "speaker": "김서연",
  "start": 559.8058,
  "end": 561.3527,
  "overlap": false,
  "text": "네 수고하셨습니다.",
  "line": 190
 }
]
