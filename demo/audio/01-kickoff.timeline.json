[
 {
  "speaker": "박준영",
  "start": 0.0,
  "end": 2.4297,
  "overlap": false,
  "text": "자, 시작할까요. 다들 오셨죠.",
  "line": 12
 },
 {
  "speaker": "이도현",
  "start": 1.8738,
  "end": 2.6309,
  "overlap": true,
  "text": "네네.",
  "line": 13
 },
 {
  "speaker": "김서연",
  "start": 1.8557,
  "end": 2.1192,
  "overlap": true,
  "text": "네.",
  "line": 14
 },
 {
  "speaker": "박준영",
  "start": 3.1174,
  "end": 8.2528,
  "overlap": false,
  "text": "오늘은 반복 일정 킥오프고요, 한 시간 안에 범위만 정하고 끝내려고 합니다.",
  "line": 15
 },
 {
  "speaker": "최민지",
  "start": 7.4785,
  "end": 7.9923,
  "overlap": true,
  "text": "좋아요.",
  "line": 16
 },
 {
  "speaker": "박준영",
  "start": 8.8399,
  "end": 15.7416,
  "overlap": false,
  "text": "배경부터 짧게 말씀드리면, 지난달 사용자 인터뷰 열 건 중에 여섯 건에서 같은 얘기가 나왔어요.",
  "line": 17
 },
 {
  "speaker": "박준영",
  "start": 15.9974,
  "end": 20.1612,
  "overlap": false,
  "text": "매주 같은 회의를 손으로 다시 만드는 게 너무 번거롭다.",
  "line": 18
 },
 {
  "speaker": "이도현",
  "start": 21.0578,
  "end": 25.7574,
  "overlap": false,
  "text": "아 그거 저도 봤어요. 주간 스크럼 매주 새로 만드는 분.",
  "line": 19
 },
 {
  "speaker": "박준영",
  "start": 26.4029,
  "end": 28.978,
  "overlap": false,
  "text": "네 그분이 제일 강하게 말씀하셨죠.",
  "line": 20
 },
 {
  "speaker": "최민지",
  "start": 29.7078,
  "end": 35.2225,
  "overlap": false,
  "text": "그분 화면 녹화 보면 진짜 매주 월요일 아침에 똑같은 걸 네 번씩 만드시더라고요.",
  "line": 21
 },
 {
  "speaker": "김서연",
  "start": 35.639,
  "end": 36.8347,
  "overlap": false,
  "text": "네 번이요?",
  "line": 22
 },
 {
  "speaker": "최민지",
  "start": 37.6868,
  "end": 39.3188,
  "overlap": false,
  "text": "팀이 네 개라서요.",
  "line": 23
 },
 {
  "speaker": "김서연",
  "start": 42.0417,
  "end": 42.4968,
  "overlap": false,
  "text": "아.",
  "line": 25
 },
 {
  "speaker": "이도현",
  "start": 43.0946,
  "end": 45.0241,
  "overlap": false,
  "text": "그건 좀 심하네요.",
  "line": 26
 },
 {
  "speaker": "박준영",
  "start": 45.8972,
  "end": 52.7705,
  "overlap": false,
  "text": "그래서 이번 분기 안에 반복 일정을 넣기로 했고, 오늘은 뭘 넣고 뭘 뺄지를 정하는 자리입니다.",
  "line": 27
 },
 {
  "speaker": "박준영",
  "start": 52.9963,
  "end": 57.2368,
  "overlap": false,
  "text": "먼저 서연님, 지금 구조에서 이게 얼마나 큰 일인가요.",
  "line": 28
 },
 {
  "speaker": "김서연",
  "start": 57.9089,
  "end": 62.2304,
  "overlap": false,
  "text": "음, 그건 어디까지 하느냐에 따라 완전히 달라져요.",
  "line": 29
 },
 {
  "speaker": "김서연",
  "start": 62.4139,
  "end": 69.5276,
  "overlap": false,
  "text": "매주 월요일 같은 단순 반복만 하면 크지 않아요. 일정 테이블에 규칙 컬럼 하나 붙이는 수준이고요.",
  "line": 30
 },
 {
  "speaker": "김서연",
  "start": 69.7784,
  "end": 76.5691,
  "overlap": false,
  "text": "그건 되는데, 다만 \"매월 셋째 주 화요일\" 같은 게 들어오면 얘기가 달라집니다.",
  "line": 31
 },
 {
  "speaker": "이도현",
  "start": 77.0912,
  "end": 77.5145,
  "overlap": false,
  "text": "왜요?",
  "line": 32
 },
 {
  "speaker": "김서연",
  "start": 78.0719,
  "end": 84.8188,
  "overlap": false,
  "text": "그건 날짜 계산이 규칙으로 안 떨어져요. 달마다 셋째 주 화요일이 며칠인지 매번 계산해야 되고요.",
  "line": 33
 },
 {
  "speaker": "김서연",
  "start": 85.1564,
  "end": 90.2461,
  "overlap": false,
  "text": "그리고 그게 공휴일이면 어떻게 할 거냐, 이런 게 줄줄이 붙습니다.",
  "line": 34
 },
 {
  "speaker": "박준영",
  "start": 89.8059,
  "end": 90.7485,
  "overlap": true,
  "text": "음.",
  "line": 35
 },
 {
  "speaker": "김서연",
  "start": 91.4396,
  "end": 96.2147,
  "overlap": false,
  "text": "예외 처리도 있어요. 반복 일정 중에 한 번만 취소하는 거요.",
  "line": 36
 },
 {
  "speaker": "이도현",
  "start": 97.2031,
  "end": 100.3283,
  "overlap": false,
  "text": "아 그거 필요하죠. 저 그거 없으면 못 씁니다.",
  "line": 37
 },
 {
  "speaker": "김서연",
  "start": 101.3053,
  "end": 105.2947,
  "overlap": false,
  "text": "필요한 건 아는데 그게 데이터 모델을 완전히 바꿔요.",
  "line": 38
 },
 {
  "speaker": "박준영",
  "start": 108.1296,
  "end": 109.8826,
  "overlap": false,
  "text": "민지님은 어떻게 보셨어요.",
  "line": 40
 },
 {
  "speaker": "최민지",
  "start": 110.6073,
  "end": 112.3414,
  "overlap": false,
  "text": "저는 좀 다르게 봤는데요.",
  "line": 41
 },
 {
  "speaker": "최민지",
  "start": 112.5606,
  "end": 117.2565,
  "overlap": false,
  "text": "인터뷰를 다시 보면, 사람들이 원한 건 복잡한 규칙이 아니었어요.",
  "line": 42
 },
 {
  "speaker": "최민지",
  "start": 117.4467,
  "end": 121.1592,
  "overlap": false,
  "text": "여섯 분 중에 다섯 분이 그냥 매주 같은 요일이었거든요.",
  "line": 43
 },
 {
  "speaker": "이도현",
  "start": 122.1412,
  "end": 125.1196,
  "overlap": false,
  "text": "어 근데 그건 지금 사용자가 그런 거고요.",
  "line": 44
 },
 {
  "speaker": "최민지",
  "start": 124.5616,
  "end": 124.9371,
  "overlap": true,
  "text": "네.",
  "line": 45
 },
 {
  "speaker": "이도현",
  "start": 125.5891,
  "end": 129.7299,
  "overlap": false,
  "text": "반복 일정이 없으니까 복잡한 걸 애초에 안 만드시는 거 아닐까요.",
  "line": 46
 },
 {
  "speaker": "최민지",
  "start": 130.504,
  "end": 131.6554,
  "overlap": false,
  "text": "그럴 수도 있죠.",
  "line": 47
 },
 {
  "speaker": "이도현",
  "start": 132.5214,
  "end": 136.0366,
  "overlap": false,
  "text": "저는 그냥 구글 캘린더처럼 다 넣는 게 맞다고 봐요.",
  "line": 48
 },
 {
  "speaker": "이도현",
  "start": 136.3399,
  "end": 141.448,
  "overlap": false,
  "text": "매일, 매주, 매월, 매년. 그리고 커스텀.",
  "line": 49
 },
 {
  "speaker": "최민지",
  "start": 142.3984,
  "end": 143.1424,
  "overlap": false,
  "text": "커스텀까지요?",
  "line": 50
 },
 {
  "speaker": "이도현",
  "start": 143.5662,
  "end": 146.7047,
  "overlap": false,
  "text": "네. 어차피 나중에 다 요청 들어올 거잖아요.",
  "line": 51
 },
 {
  "speaker": "최민지",
  "start": 147.4219,
  "end": 150.116,
  "overlap": false,
  "text": "그런데 그 화면을 한번 그려보시면요.",
  "line": 52
 },
 {
  "speaker": "최민지",
  "start": 150.3808,
  "end": 155.9391,
  "overlap": false,
  "text": "반복 주기 고르고, 요일 여러 개 고르고, 종료 조건 고르고, 예외 날짜 빼고.",
  "line": 53
 },
 {
  "speaker": "최민지",
  "start": 156.1047,
  "end": 159.9449,
  "overlap": false,
  "text": "그게 한 화면에 다 들어가면 사용자가 못 씁니다.",
  "line": 54
 },
 {
  "speaker": "이도현",
  "start": 160.7297,
  "end": 161.7318,
  "overlap": false,
  "text": "구글은 쓰던데요.",
  "line": 55
 },
 {
  "speaker": "최민지",
  "start": 162.6434,
  "end": 167.4847,
  "overlap": false,
  "text": "구글은 십 년 동안 다듬은 거고요, 저희는 이번 분기에 처음 내는 거예요.",
  "line": 56
 },
 {
  "speaker": "최민지",
  "start": 169.7829,
  "end": 173.7024,
  "overlap": false,
  "text": "그리고 저희 사용자층이 구글 캘린더 파워유저가 아니에요.",
  "line": 58
 },
 {
  "speaker": "최민지",
  "start": 173.9174,
  "end": 178.865,
  "overlap": false,
  "text": "소규모 팀이고, 대부분 주간 회의 하나 돌리려고 쓰시는 분들이거든요.",
  "line": 59
 },
 {
  "speaker": "이도현",
  "start": 179.7689,
  "end": 180.5997,
  "overlap": false,
  "text": "음.",
  "line": 60
 },
 {
  "speaker": "박준영",
  "start": 181.3054,
  "end": 185.7044,
  "overlap": false,
  "text": "도현님, 커스텀까지 넣으면 프론트 작업이 얼마나 되나요.",
  "line": 61
 },
 {
  "speaker": "이도현",
  "start": 186.4109,
  "end": 190.6188,
  "overlap": false,
  "text": "어, 규칙 편집기만 따로 잡으면... 한 주 반쯤요.",
  "line": 62
 },
 {
  "speaker": "김서연",
  "start": 191.4706,
  "end": 194.9313,
  "overlap": false,
  "text": "프론트가 한 주 반이면 백엔드는 더 걸려요.",
  "line": 63
 },
 {
  "speaker": "김서연",
  "start": 195.1183,
  "end": 201.1199,
  "overlap": false,
  "text": "규칙 저장이랑 전개 로직이랑 예외 테이블까지 하면 최소 이 주입니다.",
  "line": 64
 },
 {
  "speaker": "박준영",
  "start": 202.0117,
  "end": 204.3826,
  "overlap": false,
  "text": "그럼 둘이 합쳐서 사 주네요.",
  "line": 65
 },
 {
  "speaker": "김서연",
  "start": 205.1926,
  "end": 208.9189,
  "overlap": false,
  "text": "네. 그리고 그건 잘 풀렸을 때고요.",
  "line": 66
 },
 {
  "speaker": "이도현",
  "start": 209.7912,
  "end": 212.1064,
  "overlap": false,
  "text": "사 주는 좀 많긴 하네요.",
  "line": 67
 },
 {
  "speaker": "박준영",
  "start": 214.6214,
  "end": 216.1803,
  "overlap": false,
  "text": "민지님 안대로 가면요?",
  "line": 69
 },
 {
  "speaker": "최민지",
  "start": 217.0617,
  "end": 220.1319,
  "overlap": false,
  "text": "매주 반복만이면 화면이 아주 단순해집니다.",
  "line": 70
 },
 {
  "speaker": "최민지",
  "start": 220.3297,
  "end": 222.6071,
  "overlap": false,
  "text": "토글 하나랑 요일 선택 정도요.",
  "line": 71
 },
 {
  "speaker": "최민지",
  "start": 222.7775,
  "end": 227.7829,
  "overlap": false,
  "text": "종료 조건도 일단 \"계속 반복\"이랑 \"날짜 지정\" 두 개면 충분하고요.",
  "line": 72
 },
 {
  "speaker": "이도현",
  "start": 228.696,
  "end": 230.67,
  "overlap": false,
  "text": "그건 뭐 이삼 일이면 되죠.",
  "line": 73
 },
 {
  "speaker": "김서연",
  "start": 231.5868,
  "end": 235.3108,
  "overlap": false,
  "text": "백엔드도 비슷해요. 한 주 안쪽.",
  "line": 74
 },
 {
  "speaker": "박준영",
  "start": 236.2367,
  "end": 239.5149,
  "overlap": false,
  "text": "차이가 크네요. 사 주 대 한 주.",
  "line": 75
 },
 {
  "speaker": "이도현",
  "start": 242.198,
  "end": 246.5839,
  "overlap": false,
  "text": "근데 그러면 나중에 매월 반복 넣을 때 다시 갈아엎어야 되는 거 아니에요?",
  "line": 77
 },
 {
  "speaker": "김서연",
  "start": 247.1483,
  "end": 248.511,
  "overlap": false,
  "text": "그건 아니에요.",
  "line": 78
 },
 {
  "speaker": "김서연",
  "start": 248.6628,
  "end": 257.0714,
  "overlap": false,
  "text": "규칙을 표준 포맷으로 저장하면 나중에 확장이 됩니다. RFC 5545라고 캘린더 표준이 있어요.",
  "line": 79
 },
 {
  "speaker": "이도현",
  "start": 257.8588,
  "end": 259.7694,
  "overlap": false,
  "text": "아 아이칼 그거요?",
  "line": 80
 },
 {
  "speaker": "김서연",
  "start": 260.6013,
  "end": 269.301,
  "overlap": false,
  "text": "네. 거기 반복 규칙 스펙이 있어서, 지금은 주간만 쓰고 나중에 월간을 얹어도 스키마는 안 바뀝니다.",
  "line": 81
 },
 {
  "speaker": "이도현",
  "start": 270.2023,
  "end": 271.5116,
  "overlap": false,
  "text": "아 그러면 괜찮네요.",
  "line": 82
 },
 {
  "speaker": "최민지",
  "start": 272.0807,
  "end": 275.1724,
  "overlap": false,
  "text": "그러면 지금 좁게 가도 손해가 없는 거네요.",
  "line": 83
 },
 {
  "speaker": "김서연",
  "start": 275.7015,
  "end": 280.0988,
  "overlap": false,
  "text": "스키마는요. UI는 어차피 다시 그려야 하고요.",
  "line": 84
 },
 {
  "speaker": "최민지",
  "start": 280.8824,
  "end": 286.3847,
  "overlap": false,
  "text": "UI는 다시 그리는 게 맞아요. 처음부터 복잡하게 그려놓는 것보다 낫습니다.",
  "line": 85
 },
 {
  "speaker": "박준영",
  "start": 290.2677,
  "end": 295.5555,
  "overlap": false,
  "text": "정리하면, 일차는 주간 반복만. 매월이랑 커스텀은 이차로 미룬다.",
  "line": 87
 },
 {
  "speaker": "박준영",
  "start": 295.9464,
  "end": 301.0171,
  "overlap": false,
  "text": "대신 저장 포맷은 처음부터 표준을 써서 나중에 확장 가능하게 한다.",
  "line": 88
 },
 {
  "speaker": "김서연",
  "start": 301.5074,
  "end": 303.2299,
  "overlap": false,
  "text": "네 그게 맞습니다.",
  "line": 89
 },
 {
  "speaker": "최민지",
  "start": 303.9192,
  "end": 304.5189,
  "overlap": false,
  "text": "동의해요.",
  "line": 90
 },
 {
  "speaker": "박준영",
  "start": 305.4557,
  "end": 306.4009,
  "overlap": false,
  "text": "도현님은요.",
  "line": 91
 },
 {
  "speaker": "이도현",
  "start": 307.0545,
  "end": 310.7413,
  "overlap": false,
  "text": "어... 네. 스키마가 안 바뀐다면 저는 괜찮아요.",
  "line": 92
 },
 {
  "speaker": "박준영",
  "start": 311.495,
  "end": 313.1758,
  "overlap": false,
  "text": "그럼 그렇게 결정하겠습니다.",
  "line": 93
 },
 {
  "speaker": "박준영",
  "start": 315.3319,
  "end": 317.782,
  "overlap": false,
  "text": "예외 처리는요? 한 번만 취소하는 거.",
  "line": 95
 },
 {
  "speaker": "김서연",
  "start": 318.5861,
  "end": 321.1228,
  "overlap": false,
  "text": "그건 일차에 있어야 될 것 같은데요.",
  "line": 96
 },
 {
  "speaker": "최민지",
  "start": 322.0743,
  "end": 326.738,
  "overlap": false,
  "text": "저도 그거는 필요하다고 봐요. 없으면 반복 일정을 못 켜요.",
  "line": 97
 },
 {
  "speaker": "최민지",
  "start": 327.0947,
  "end": 331.1658,
  "overlap": false,
  "text": "한 번 휴가 갔다고 전체를 지워야 되면 아무도 안 씁니다.",
  "line": 98
 },
 {
  "speaker": "이도현",
  "start": 332.0971,
  "end": 332.5296,
  "overlap": false,
  "text": "그쵸.",
  "line": 99
 },
 {
  "speaker": "박준영",
  "start": 333.3258,
  "end": 336.7174,
  "overlap": false,
  "text": "서연님 그거 넣으면 얼마나 늘어나요.",
  "line": 100
 },
 {
  "speaker": "김서연",
  "start": 337.2647,
  "end": 341.4055,
  "overlap": false,
  "text": "이삼 일이요. 예외 날짜만 따로 저장하면 되니까요.",
  "line": 101
 },
 {
  "speaker": "박준영",
  "start": 342.2666,
  "end": 343.2679,
  "overlap": false,
  "text": "그 정도면 넣죠.",
  "line": 102
 },
 {
  "speaker": "김서연",
  "start": 342.8621,
  "end": 343.1256,
  "overlap": true,
  "text": "네.",
  "line": 103
 },
 {
  "speaker": "박준영",
  "start": 344.1667,
  "end": 348.8444,
  "overlap": false,
  "text": "그럼 일차 범위는 주간 반복 더하기 개별 회차 취소. 여기까지.",
  "line": 104
 },
 {
  "speaker": "박준영",
  "start": 351.0101,
  "end": 353.4038,
  "overlap": false,
  "text": "그럼 이건 누가 가져가죠.",
  "line": 106
 },
 {
  "speaker": "박준영",
  "start": 353.7602,
  "end": 354.8336,
  "overlap": false,
  "text": "먼저 스키마요.",
  "line": 107
 },
 {
  "speaker": "김서연",
  "start": 355.3323,
  "end": 356.4548,
  "overlap": false,
  "text": "제가 하겠습니다.",
  "line": 108
 },
 {
  "speaker": "박준영",
  "start": 357.0799,
  "end": 358.2946,
  "overlap": false,
  "text": "언제까지 될까요.",
  "line": 109
 },
 {
  "speaker": "김서연",
  "start": 358.8846,
  "end": 361.6007,
  "overlap": false,
  "text": "다음 주 월요일까지 설계안 올릴게요.",
  "line": 110
 },
 {
  "speaker": "박준영",
  "start": 362.4155,
  "end": 363.2386,
  "overlap": false,
  "text": "이십이일이요?",
  "line": 111
 },
 {
  "speaker": "김서연",
  "start": 363.7457,
  "end": 365.3228,
  "overlap": false,
  "text": "네 이십이일.",
  "line": 112
 },
 {
  "speaker": "박준영",
  "start": 365.9606,
  "end": 368.4545,
  "overlap": false,
  "text": "좋습니다. 그날 기술 리뷰로 잡죠.",
  "line": 113
 },
 {
  "speaker": "김서연",
  "start": 368.1516,
  "end": 368.4151,
  "overlap": true,
  "text": "네.",
  "line": 114
 },
 {
  "speaker": "박준영",
  "start": 369.012,
  "end": 370.1984,
  "overlap": false,
  "text": "와이어프레임은요.",
  "line": 115
 },
 {
  "speaker": "최민지",
  "start": 370.8511,
  "end": 373.7322,
  "overlap": false,
  "text": "제가 할게요. 세 안 정도 만들어서 볼게요.",
  "line": 116
 },
 {
  "speaker": "박준영",
  "start": 374.1958,
  "end": 374.894,
  "overlap": false,
  "text": "세 안이요?",
  "line": 117
 },
 {
  "speaker": "최민지",
  "start": 375.6739,
  "end": 381.4729,
  "overlap": false,
  "text": "반복 설정을 어디에 두느냐가 갈려서요. 일정 만들기 안에 넣을지, 따로 뺄지.",
  "line": 118
 },
 {
  "speaker": "박준영",
  "start": 382.1012,
  "end": 384.8572,
  "overlap": false,
  "text": "아 그러네요. 언제까지요.",
  "line": 119
 },
 {
  "speaker": "최민지",
  "start": 385.6924,
  "end": 388.2116,
  "overlap": false,
  "text": "이번 주 금요일까지요. 십구일.",
  "line": 120
 },
 {
  "speaker": "박준영",
  "start": 389.0039,
  "end": 390.0882,
  "overlap": false,
  "text": "네 십구일.",
  "line": 121
 },
 {
  "speaker": "박준영",
  "start": 392.346,
  "end": 397.6372,
  "overlap": false,
  "text": "도현님은 기존 일정 생성 코드가 지금 어떻게 돼 있는지 좀 봐주세요.",
  "line": 123
 },
 {
  "speaker": "이도현",
  "start": 396.9035,
  "end": 397.6374,
  "overlap": true,
  "text": "아 네.",
  "line": 124
 },
 {
  "speaker": "박준영",
  "start": 398.4167,
  "end": 402.6591,
  "overlap": false,
  "text": "반복이 붙었을 때 어디가 깨지는지 미리 알아야 될 것 같아서요.",
  "line": 125
 },
 {
  "speaker": "이도현",
  "start": 403.5453,
  "end": 405.6938,
  "overlap": false,
  "text": "네 그거 이번 주 안에 볼게요.",
  "line": 126
 },
 {
  "speaker": "박준영",
  "start": 406.2989,
  "end": 408.9514,
  "overlap": false,
  "text": "목요일쯤 짧게 공유해주시면 좋겠어요.",
  "line": 127
 },
 {
  "speaker": "이도현",
  "start": 409.6776,
  "end": 410.7761,
  "overlap": false,
  "text": "네 목요일에요.",
  "line": 128
 },
 {
  "speaker": "박준영",
  "start": 413.2939,
  "end": 417.1662,
  "overlap": false,
  "text": "그리고 제가 경쟁사 조사 문서를 만들어뒀는데요.",
  "line": 130
 },
 {
  "speaker": "박준영",
  "start": 417.5652,
  "end": 423.0746,
  "overlap": false,
  "text": "노션, 리니어, 구글 캘린더 세 개 반복 일정 UI 정리한 거예요.",
  "line": 131
 },
 {
  "speaker": "최민지",
  "start": 423.6205,
  "end": 425.2204,
  "overlap": false,
  "text": "아 그거 주세요.",
  "line": 132
 },
 {
  "speaker": "박준영",
  "start": 425.7745,
  "end": 428.1569,
  "overlap": false,
  "text": "네 오늘 중으로 공유드릴게요.",
  "line": 133
 },
 {
  "speaker": "최민지",
  "start": 428.6008,
  "end": 429.4078,
  "overlap": false,
  "text": "감사합니다.",
  "line": 134
 },
 {
  "speaker": "박준영",
  "start": 429.9625,
  "end": 434.3331,
  "overlap": false,
  "text": "민지님 와이어프레임 그리시기 전에 한 번 보시면 좋을 것 같아서요.",
  "line": 135
 },
 {
  "speaker": "최민지",
  "start": 435.191,
  "end": 438.216,
  "overlap": false,
  "text": "네 오늘 받으면 내일 보고 시작할게요.",
  "line": 136
 },
 {
  "speaker": "박준영",
  "start": 442.0347,
  "end": 443.7656,
  "overlap": false,
  "text": "더 얘기할 거 있으실까요.",
  "line": 138
 },
 {
  "speaker": "김서연",
  "start": 444.2428,
  "end": 445.3781,
  "overlap": false,
  "text": "하나 있는데요.",
  "line": 139
 },
 {
  "speaker": "박준영",
  "start": 444.89,
  "end": 445.2456,
  "overlap": true,
  "text": "네.",
  "line": 140
 },
 {
  "speaker": "김서연",
  "start": 446.0307,
  "end": 451.5836,
  "overlap": false,
  "text": "알림이요. 반복 일정에 알림이 붙으면 그것도 반복되잖아요.",
  "line": 141
 },
 {
  "speaker": "박준영",
  "start": 450.9511,
  "end": 451.4576,
  "overlap": true,
  "text": "아.",
  "line": 142
 },
 {
  "speaker": "김서연",
  "start": 452.2572,
  "end": 459.1858,
  "overlap": false,
  "text": "그게 지금 알림 시스템이랑 어떻게 엮이는지를 봐야 되는데, 오늘 정할 건 아닌 것 같고요.",
  "line": 143
 },
 {
  "speaker": "김서연",
  "start": 459.4824,
  "end": 463.4461,
  "overlap": false,
  "text": "다음 주 기술 리뷰 때 같이 보면 좋겠어요.",
  "line": 144
 },
 {
  "speaker": "박준영",
  "start": 464.3499,
  "end": 466.8574,
  "overlap": false,
  "text": "네 그거 안건에 넣어두겠습니다.",
  "line": 145
 },
 {
  "speaker": "이도현",
  "start": 467.6933,
  "end": 470.5008,
  "overlap": false,
  "text": "알림은 좀 조심해야 될 것 같긴 해요.",
  "line": 146
 },
 {
  "speaker": "김서연",
  "start": 471.1198,
  "end": 473.3378,
  "overlap": false,
  "text": "네 저도 그 생각이에요.",
  "line": 147
 },
 {
  "speaker": "박준영",
  "start": 476.0068,
  "end": 477.6435,
  "overlap": false,
  "text": "그럼 오늘은 여기까지 하죠.",
  "line": 149
 },
 {
  "speaker": "박준영",
  "start": 477.8854,
  "end": 482.4125,
  "overlap": false,
  "text": "다시 한번 정리하면, 일차는 주간 반복이랑 개별 회차 취소까지.",
  "line": 150
 },
 {
  "speaker": "박준영",
  "start": 482.5899,
  "end": 488.9672,
  "overlap": false,
  "text": "서연님 스키마 이십이일, 민지님 와이어프레임 십구일, 도현님 기존 코드 조사 목요일.",
  "line": 151
 },
 {
  "speaker": "박준영",
  "start": 489.168,
  "end": 491.8522,
  "overlap": false,
  "text": "저는 경쟁사 조사 오늘 공유.",
  "line": 152
 },
 {
  "speaker": "최민지",
  "start": 492.4225,
  "end": 492.798,
  "overlap": false,
  "text": "네.",
  "line": 153
 },
 {
  "speaker": "김서연",
  "start": 493.3865,
  "end": 494.7062,
  "overlap": false,
  "text": "네 알겠습니다.",
  "line": 154
 },
 {
  "speaker": "이도현",
  "start": 495.294,
  "end": 495.5667,
  "overlap": false,
  "text": "넵.",
  "line": 155
 },
 {
  "speaker": "박준영",
  "start": 496.3127,
  "end": 501.1951,
  "overlap": false,
  "text": "다음 회의는 이십이일 월요일 같은 시간에 기술 리뷰로 하겠습니다.",
  "line": 156
 },
 {
  "speaker": "박준영",
  "start": 501.588,
  "end": 502.6518,
  "overlap": false,
  "text": "수고하셨습니다.",
  "line": 157
 },
 {
  "speaker": "최민지",
  "start": 503.5166,
  "end": 504.4518,
  "overlap": false,
  "text": "수고하셨어요.",
  "line": 158
 },
 {
  "speaker": "이도현",
  "start": 503.7562,
  "end": 504.7848,
  "overlap": true,
  "text": "수고하셨습니다.",
  "line": 159
 },
 {
  "speaker": "김서연",
  "start": 505.6404,
  "end": 507.1933,
  "overlap": false,
  "text": "네 수고하세요.",
  "line": 160
 }
]
