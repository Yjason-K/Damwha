{
  "name": "damwha",
  "version": "0.2.3",
  "private": true,
  "description": "Damwha (담화) — personal, self-hosted conversation recording & search. Monorepo: damwha-be (NestJS API + Python ML worker) and damwha-fe (React SPA).",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "be": "pnpm --filter damwha-be run",
    "be:dev": "pnpm --filter damwha-be run start:dev",
    "be:build": "pnpm --filter damwha-be run build",
    "be:start": "pnpm --filter damwha-be run start",
    "be:migrate": "pnpm --filter damwha-be run migrate",
    "be:test": "pnpm --filter damwha-be run test",
    "be:test:e2e": "pnpm --filter damwha-be run test:e2e",
    "fe": "pnpm --filter damwha-fe run",
    "fe:dev": "pnpm --filter damwha-fe run dev",
    "fe:build": "pnpm --filter damwha-fe run build",
    "fe:preview": "pnpm --filter damwha-fe run preview",
    "fe:lint": "pnpm --filter damwha-fe run lint",
    "fe:format": "pnpm --filter damwha-fe run format",
    "fe:test": "pnpm --filter damwha-fe run test",
    "desktop": "pnpm --filter damwha-desktop run",
    "desktop:dev": "pnpm --filter damwha-desktop run start:desktop",
    "desktop:build": "pnpm --filter damwha-desktop run package:desktop",
    "site": "pnpm --filter damwha-site run",
    "site:dev": "pnpm --filter damwha-site run start",
    "site:build": "pnpm --filter damwha-site run build",
    "worker": "uv run --directory be/worker python -m damwha_worker",
    "embed": "uv run --directory be/worker damwha-embed",
    "worker:sync": "uv sync --directory be/worker --extra models",
    "worker:sync:test": "uv sync --directory be/worker",
    "worker:test": "uv run --directory be/worker pytest -q",
    "db:up": "docker compose -f be/docker-compose.yml up -d",
    "db:down": "docker compose -f be/docker-compose.yml down",
    "db:logs": "docker compose -f be/docker-compose.yml logs -f postgres"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "cpu-features",
      "esbuild",
      "protobufjs",
      "ssh2"
    ],
    "overrides": {
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "^1.14.5",
      "ajv@>=8 <8.18.0": "^8.18.0",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "body-parser@<1.20.6": "^1.20.6",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2 <2.1.7": "^2.1.7",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "fast-uri@>=3 <3.1.8": "^3.1.8",
      "file-type@<21.3.2": "^21.3.2",
      "glob@>=10 <10.5.0": "^10.5.0",
      "js-yaml@>=3 <3.15.2": "^3.15.2",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "lodash@<4.18.0": "^4.18.0",
      "multer": "2.4.0",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "picomatch@>=4 <4.0.4": "^4.0.4",
      "postcss@<8.5.23": "^8.5.23",
      "qs@<6.16.0": "^6.16.0",
      "tmp@<0.2.6": "^0.2.6",
      "undici@>=7 <7.29.1": "^7.29.1",
      "uuid@<11.1.1": "^11.1.1",
      "webpack@<5.104.1": "^5.104.1"
    }
  }
}
