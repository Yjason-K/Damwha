---
// CLI · MCP 문서 페이지 본문 (spec 2026-10-20 §2.8). 문구는 i18n의 cliPage에만 있다.
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { getDictionary, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDictionary(lang);
const c = t.cliPage;
const manual = [
  [c.install.linkLabel, c.install.link, undefined],
  [c.install.claudeCodeLabel, c.install.claudeCode, undefined],
  [c.install.codexLabel, c.install.codex, undefined],
  [c.install.jsonLabel, c.install.json, c.install.jsonNote],
] as const;
const tables = [
  { id: "commands", title: c.commands.title, lede: c.commands.lede, head: c.commands.head, rows: c.commands.items },
  { id: "mcp-tools", title: c.mcp.title, lede: c.mcp.lede, head: c.mcp.head, rows: c.mcp.items },
] as const;
---
<Header lang={lang} path="cli/" />
<main>
  <section>
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 sm:py-24">
      <p class="text-ink-2 font-mono text-[13px]">{c.eyebrow}</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{c.title}</h1>
      <p class="text-ink-2 mt-4 max-w-2xl text-lg leading-relaxed">{c.lede}</p>
      <p class="text-ink-2 mt-4 max-w-2xl leading-relaxed">{c.needsApp}</p>
    </div>
  </section>

  <section id="install" class="border-line border-t">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-tight">{c.install.title}</h2>
      <h3 class="mt-8 text-lg font-semibold">{c.install.oneClickTitle}</h3>
      <p class="text-ink-2 mt-2 max-w-2xl leading-relaxed">{c.install.oneClickBody}</p>
      <p class="text-ink-2 mt-2 text-sm">{c.install.oneClickNote}</p>
      <h3 class="mt-10 text-lg font-semibold">{c.install.manualTitle}</h3>
      <p class="text-ink-2 mt-2 max-w-2xl leading-relaxed">{c.install.manualBody}</p>
      <div class="mt-6 flex flex-col gap-5">
        {manual.map(([label, code, note]) => (
          <div>
            <p class="text-sm font-medium">{label}</p>
            <pre tabindex="0" aria-label={label} class="border-line-2 bg-card mt-2 overflow-x-auto rounded-md border px-3 py-2.5 font-mono text-[13px] leading-relaxed"><code>{code}</code></pre>
            {note && <p class="text-ink-2 mt-1.5 text-sm">{note}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  {tables.map((tb) => (
    <section id={tb.id} class="border-line border-t">
      <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
        <h2 class="text-2xl font-semibold tracking-tight">{tb.title}</h2>
        <p class="text-ink-2 mt-3 max-w-2xl leading-relaxed">{tb.lede}</p>
        <table class="mt-8 w-full text-left text-sm">
          <thead>
            <tr class="border-line border-b">
              <th scope="col" class="py-2 pr-4 font-medium">{tb.head[0]}</th>
              <th scope="col" class="py-2 font-medium">{tb.head[1]}</th>
            </tr>
          </thead>
          <tbody class="divide-line divide-y">
            {tb.rows.map(([name, desc]) => (
              <tr class="align-top">
                <th scope="row" class="py-3 pr-4 text-left font-mono text-[13px] font-normal whitespace-nowrap max-sm:whitespace-normal">{name}</th>
                <td class="text-ink-2 py-3 leading-relaxed">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {tb.id === "commands" && (
          <>
            <h3 class="mt-10 text-lg font-semibold">{c.commands.exitTitle}</h3>
            <dl class="border-line mt-4 divide-y divide-line border-y">
              {c.commands.exit.map(([code, desc]) => (
                <div class="grid grid-cols-[3rem_1fr] gap-3 py-3 text-sm">
                  <dt class="font-mono">{code}</dt>
                  <dd class="text-ink-2">{desc}</dd>
                </div>
              ))}
            </dl>
          </>
        )}
      </div>
    </section>
  ))}

  <section id="confirm" class="border-line border-t">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-tight">{c.confirm.title}</h2>
      <p class="text-ink-2 mt-3 max-w-2xl leading-relaxed">{c.confirm.body}</p>
    </div>
  </section>

  <section id="data" class="border-line border-t">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-tight">{c.trust.title}</h2>
      <p class="mt-3 max-w-2xl text-lg leading-relaxed">{c.trust.body}</p>
      <p class="text-ink-2 mt-3 max-w-2xl leading-relaxed">{c.trust.untrusted}</p>
    </div>
  </section>
</main>
<Footer t={t} />
