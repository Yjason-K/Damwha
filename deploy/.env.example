# Copy to `.env`. Read by BOTH `docker compose` (for ${...} in the compose file)
# and the host worker/embed service (pydantic-settings, cwd `.env`) — run the
# worker from this directory.

# Release you downloaded — images and wheel share this tag.
DAMWHA_VERSION=0.1.1

# ---- worker (host) ----
# Host view of the compose Postgres. The api container gets its own value.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/damwha
STORAGE_ROOT=./storage
WORKER_ID=worker-1
# pyannote is gated: accept the three licenses in README.md, then paste your token.
HF_TOKEN=

# ---- lens / summary LLM (mlx_lm.server, started per job by the worker) ----
LENS_LLM_BASE_URL=http://127.0.0.1:8000/v1
LENS_LLM_MANAGED=true
# Must be one of mlx-community/Qwen3.5-{4B,9B,27B}-8bit. 4B ≈ 4 GB, 27B ≈ 28 GB RAM.
LENS_LLM_MODEL=mlx-community/Qwen3.5-4B-8bit
SUMMARY_LLM_MODEL=mlx-community/Qwen3.5-4B-8bit
