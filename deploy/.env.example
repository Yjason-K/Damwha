# Copy to `.env`. Read by BOTH `docker compose` (for ${...} in the compose file)
# and the host worker/embed service (pydantic-settings, cwd `.env`) — run the
# worker from this directory.

# Release you downloaded — images and wheel share this tag.
DAMWHA_VERSION=0.2.3

# ---- host ports ----
# Where this stack listens ON THE HOST. Both default to the service port with a
# `1` in front, because the plain 3000/5432 belong to the dev stack in this repo
# (`pnpm dev`, `pnpm db:up`) and docker refuses to bind a port twice.
# Uncomment and change if these are taken too; `make up` stops before starting
# when either is busy and tells you which one.
# DAMWHA_API_PORT=13000     # browser + API + /docs
# DAMWHA_DB_PORT=15432      # Postgres, for the host worker below

# ---- host machine spec (shown in 처리 설정, drives the recommended preset) ----
# Only used until the worker first starts: it measures the same machine properly
# (including whether the GPU really works) and writes that to the DB, which wins.
# These cover the gap before then — the api container cannot see the host itself,
# where os.totalmem() is Docker Desktop's VM allocation and sysctl is absent.
# Fill both with one command from this folder:
#
#   printf 'CAPABILITIES_MEMORY_GB=%d\nCAPABILITIES_CHIP=%s\n' \
#     "$(( $(sysctl -n hw.memsize) / 1073741824 ))" \
#     "$(sysctl -n machdep.cpu.brand_string)" >> .env
#
# Left empty the app still works — the spec card shows the container until the
# worker's first report lands.
CAPABILITIES_MEMORY_GB=
CAPABILITIES_CHIP=

# ---- worker (host) ----
# Host view of the compose Postgres. The api container gets its own value.
# The port here must match DAMWHA_DB_PORT above — `make check` refuses to run if
# they drift, because the worker would then dial a Postgres that is not this one.
DATABASE_URL=postgres://postgres:postgres@localhost:15432/damwha
STORAGE_ROOT=./storage
WORKER_ID=worker-1
# pyannote is gated: accept the three licenses in README.md, then paste your token.
HF_TOKEN=

# ---- lens / summary LLM (mlx_lm.server, started per job by the worker) ----
LENS_LLM_BASE_URL=http://127.0.0.1:8000/v1
LENS_LLM_MANAGED=true
# Must be one of mlx-community/Qwen3.5-{4B,9B,27B}-8bit. 4B ≈ 4 GB, 27B ≈ 28 GB RAM.
LENS_LLM_MODEL=mlx-community/Qwen3.5-4B-8bit
SUMMARY_LLM_MODEL=mlx-community/Qwen3.5-4B-8bit
