PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/damwha
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=1073741824
REAPER_STALE_MINUTES=30
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=mps
STT_LANGUAGE=ko
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
EMBEDDING_DIM=192
# 2단계 화자 식별. THRESHOLD 이상이면 자동 연결, SUGGEST_THRESHOLD까지는 제안만 남긴다.
# 기본값은 worker/scripts/eval_speaker_id.py 실측 기준 — 임의로 바꾸지 말고 그 도구로 다시 재라.
IDENTIFY_THRESHOLD=0.80
IDENTIFY_SUGGEST_THRESHOLD=0.60

# Search / embed service
SEARCH_EMBEDDING_MODEL=BAAI/bge-m3
SEARCH_EMBEDDING_DIM=1024
EMBED_SERVICE_URL=http://127.0.0.1:8100
EMBED_SERVICE_TIMEOUT_MS=800
EMBED_SERVICE_ALLOW_NON_LOOPBACK=false
SEARCH_RRF_K=60
SEARCH_CANDIDATE_K=100
# 목록 제한: mlx-community/Qwen3.5-{4B,9B,27B}-8bit (= mlx_lm.server가 받는 HF repo id)
# 목록 밖 값이면 API가 시작하지 않는다. 목록은 src/contracts/model-catalog.ts.
# 이 값은 처리 설정이 없을 때의 폴백 + summary_model이 없던 레거시 custom 행의 기본값이다.
SUMMARY_LLM_MODEL=mlx-community/Qwen3.5-4B-8bit

# 공개 데모 읽기 전용 (설계 §3.6). true면 GET/HEAD/OPTIONS와 POST /search 외 전부 403.
DEMO_READ_ONLY=false
