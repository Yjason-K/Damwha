DATABASE_URL=postgres://postgres:postgres@localhost:5432/damwha
STORAGE_ROOT=../storage
WORKER_ID=worker-1
HF_TOKEN=
POLL_INTERVAL_SECONDS=2
HEARTBEAT_INTERVAL_SECONDS=30
STT_CHUNK_MINUTES=25
MODEL_CACHE_DIR=

# Search / embed service
SEARCH_EMBEDDING_MODEL=BAAI/bge-m3
SEARCH_EMBEDDING_DIM=1024
EMBED_SERVICE_HOST=127.0.0.1
EMBED_SERVICE_PORT=8100

# Lens extraction LLM — any loopback OpenAI-compatible server. Ollama 의존성은 없다.
# 요약 모델명은 카탈로그(src/contracts/model-catalog.ts)로 고정이고 그 값이 곧
# mlx_lm.server가 받는 HF repo id다 (별칭을 걸 방법이 없다; SMOKE.md 참고):
#   mlx_lm.server --model mlx-community/Qwen3.5-4B-8bit --port 8000 \
#     --chat-template-args '{"enable_thinking":false}'
#
# LENS_LLM_BASE_URL은 **필수**다(기본값 없음 — DATABASE_URL과 같은 취급). 기본값이
# 있으면 "주소 미설정"과 "그 주소에 서버 없음"이 구별되지 않는다. 워커는 이 주소의
# host:port로 서버를 띄우므로 포트가 명시돼 있어야 한다.
LENS_LLM_BASE_URL=http://127.0.0.1:8000/v1
# 렌즈/요약 자식이 job 직전에 mlx_lm.server를 띄우고 job이 끝나면 내린다 — 큐가 빈
# 동안 모델(8bit 27B면 ~28GB)이 메모리를 쥐고 있지 않게 하는 것이 목적이다. 이미 떠
# 있는 서버를 발견하면 사람이 띄운 것으로 보고 재사용만 하고 죽이지 않는다.
# false면 예전처럼 사람이 직접 띄운 서버를 그대로 쓴다.
LENS_LLM_MANAGED=true
LENS_LLM_SERVER_BIN=mlx_lm.server
# 첫 실행은 HF 다운로드를 포함한다 — 27B는 수십 GB.
LENS_LLM_SERVER_START_TIMEOUT_SECONDS=600
LENS_LLM_SERVER_STOP_TIMEOUT_SECONDS=20
LENS_LLM_MODEL=mlx-community/Qwen3.5-4B-8bit
LENS_LLM_TIMEOUT_SECONDS=300
# 렌즈/요약 공통 생성 길이 상한. 서버 기본값(mlx_lm.server는 512)에 맡기면 JSON이
# 중간에서 잘려 llm_invalid_response로 실패한다 — 넉넉히 잡는다.
LENS_LLM_MAX_TOKENS=8192
# Conversation summary reuses LENS_LLM_BASE_URL but carries its own model name.
# v1/v2 payload(= summary_model이 없던 레거시)에서만 쓰이는 폴백이다 — v3는 API가
# 프리셋에서 고른 값을 payload에 각인해 보낸다. 카탈로그 목록 안의 값이어야 한다.
SUMMARY_LLM_MODEL=mlx-community/Qwen3.5-4B-8bit
