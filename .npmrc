# pnpm reads .npmrc from the workspace ROOT (plus cwd and $HOME) — never from a
# member package. fe/.npmrc was deleted when fe became a workspace member, so
# its engine-strict rule has to live here or it silently stops applying.
engine-strict=true

# Deliberately NOT set: shamefully-hoist / node-linker=hoisted /
# public-hoist-pattern[]. Both packages install clean under pnpm's default
# isolated linker. If an import ever fails to resolve, the fix is to declare the
# dependency in the package that imports it — not to hoist. (`multer` was
# exactly that bug: be/src/storage/upload-options.ts imported it while only
# @nestjs/platform-express declared it.)
